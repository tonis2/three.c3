<*
 A shader program written from C3.

 The generator's claim is that every declaration in the module is the engine's
 own - the wire structs from `abi.c3`, the push block from a C3 struct, the rest
 from the def - so what is checked here is shape: one module with no markers, no
 macros and no `#ifdef`, every part present and in the place the old templates
 had it, and a body bracketed so a fault inside it names the file its author
 wrote.

 Whether the module *compiles* is shady's question, and the engine depends on
 shady, so it is asked here as well: every module generated by the real defs
 below is handed to the compiler. Kong asks it once more against the Vulkan
 environment, which is where a module can still be wrong after this passes.
*>
module three_tests::shader_def;

import three;
import shady;
import std::core::test;
import std::io;
import std::io::file;
import std::io::path;

<*
 One whole program: two stages, a sampler, the bindless table, a feature, and a
 body under a `#line`.

 `three::SkyPush` is the push block because it is the smallest wire struct with
 nothing to point at, which keeps the generated text short enough to read.
*>
macro String sky_program(String body_file)
{
	three::ShaderIo[] io = {
		{ "VertexIn", (three::ShaderIoField[]) {
			{ "vid", "uint", "@builtin(vertex_index)" },
		} },
		{ "VertexOutput", (three::ShaderIoField[]) {
			{ "sv_position", "float4", "@position" },
			{ "clip", "float2", "" },
		} },
	};
	three::ShaderResource[] resources = {
		{ "sky_map", "Sampler2D", 0, 0, false },
		{ "three_textures", "Sampler2D", 1, 0, true },
	};
	three::ShaderFeature[] features = { { "SHADOWS", "bool", "true", 0 } };
	three::ShaderStage[] stages = {
		// An entry point takes a struct, not a bare builtin - shady says so, and
		// it is the same rule for a vertex stage as for a compute one. The
		// vertex body here is a file's code, the fragment's is a script's.
		{
			.kind = shady::Stage.VERTEX,
			.entry = "vertexMain",
			.params = "VertexIn input",
			.returns = "VertexOutput",
			.body = "VertexOutput output;\nreturn output;\n",
			.body_file = "sky",
		},
		{
			.kind = shady::Stage.FRAGMENT,
			.entry = "fragmentMain",
			.params = "VertexOutput input",
			.returns = "float4",
			.body = "return float4(1.0);\n",
			.body_file = body_file,
		},
	};
	three::ShaderDef def = {
		.name      = "sky",
		.io        = io,
		.resources = resources,
		.features  = features,
		.stages    = stages,
	};

	DString out;
	out.tinit(16384);
	three::append_shader_def(&out, def, three::SkyPush);
	return out.str_view();
}

fn void a_def_emits_the_whole_module() @test
{
	String source = sky_program("sky");

	// The push block: a C3 struct that became a block, and the variable every
	// entry point reaches it through.
	test::@check(source.contains("struct SkyPush @pushconstant"), "the push struct is marked\n%s", source);
	test::@check(source.contains("SkyPush push;"), "and a variable of it exists");
	test::@check(source.contains("float4x4 inverse_view_projection;"),
		"walked from the C3 struct rather than written in the shader");

	// The structure the def described.
	test::@check(source.contains("struct VertexOutput\n{\n\tfloat4 sv_position @position;\n\tfloat2 clip;\n}"),
		"stage IO is emitted as written: %s", source);
	test::@check(source.contains("const bool SHADOWS @spec(0) = true;"), "the feature is a spec constant");
	test::@check(source.contains("Sampler2D sky_map @set(0) @binding(0);"), "a resource carries its binding");
	test::@check(source.contains("Sampler2D three_textures[] @set(1) @binding(0);"),
		"and a runtime-sized one is the bindless table");

	// The entry points, and the body behind one.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the vertex signature is generated");
	test::@check(source.contains("fn float4 fragmentMain(VertexOutput input) @fragment"),
		"and so is the fragment signature");
	test::@check(source.contains("#line 1 \"sky\""), "the body is numbered from one, in the body's name");
	test::@check(!source.contains("#define") && !source.contains("#if") && !source.contains("//@"),
		"and there are no markers and no macros anywhere");
}

<*
 A body is numbered from one under its own name, and the module is numbered again
 after it.

 The restore directive is checked rather than the body's: a directive numbers
 the line that *follows* it, so one written from a template's shape is right
 until a body grows a line, and then points every later diagnostic one line off.
 Counting the physical line here is the same arithmetic the emitter is trusted
 to do.
*>
fn void a_restore_directive_numbers_the_line_after_it() @test
{
	String source = sky_program("material");

	uint line = 1;
	usz  at   = 0;
	while (at < source.len)
	{
		usz end = at;
		while (end < source.len && source[end] != '\n') end++;
		String text = source[at:end - at];

		if (text.starts_with("#line "))
		{
			if (text.contains("three."))
			{
				// `#line N "three.sky"` must name the line straight after itself.
				String expected = string::tformat("#line %d \"", line + 1);
				test::@check(text.starts_with(expected),
					"the restore on line %d should number line %d: %s", line, line + 1, text);
			}
			else
			{
				test::@check(text.starts_with("#line 1 \""), "a body is numbered from one: %s", text);
			}
		}
		line++;
		at = end + 1;
	}
	test::@check(source.contains("#line 1 \"material\""), "the body's own name reaches the directive");
}

<*
 The real thing: `sky.slang`'s port, through the def that describes the pass.

 What this writes is what kong compiles and validates - the bridge by which a
 generated module is asked whether it is one before the engine is switched over.
*>
fn void the_ported_sky_module_is_generated() @test
{
	String code = three::load_source("shaders/sky.shady")!!;
	defer code.free(mem);

	three::ShaderDef def = three::sky_def(code);

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::SkyPush);
	String source = out.str_view();

	// The ported code, under the file's own name, so a fault inside it is
	// reported in `sky.shady` rather than in the module that generated it.
	test::@check(source.contains("#line 1 \"sky\""), "the ported code is numbered under its own name");
	test::@check(source.contains("fn float2 equirect_uv(float3 direction)"), "the helper survived the port");
	test::@check(source.contains("fn VertexOutput sky_vertex(VertexIn input)"), "and so did the vertex stage");
	test::@check(source.contains("sky_map.Sample(equirect_uv(direction))"),
		"a sampler is a method call, as the rest of the port will be");
	test::@check(source.contains("atan2(direction.x, -direction.z)"),
		"and `atan2` is the builtin rather than a rewritten quadrant case");

	// The generated entry points around it.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the entry point wraps the ported vertex");
	test::@check(source.contains("fn float4 fragmentMain(VertexOutput input) @fragment"),
		"and the fragment entry wraps the fragment");
	test::@check(source.contains("return sky_fragment(input);"), "each stage is a call and nothing else");
	test::@check(!source.contains("#define") && !source.contains("#if") && !source.contains("//@"),
		"with no markers, no macros and no #ifdef anywhere:\n%s", source);

	check_compiles(source, "the generated sky module");

	// And again in kong, against the Vulkan environment rather than the generic
	// one: `spirv-val --target-env vulkan1.3` is the stricter reader, and it is
	// where the ported sky gets drawn.
	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/sky.shady", source)!!;
}

fn void a_compute_stage_carries_its_thread_counts() @test
{
	three::ShaderIo[] io = {
		{ "ComputeIn", (three::ShaderIoField[]) { { "id", "uint3", "@builtin(global_invocation_id)" } } },
	};
	three::ShaderStage[] stages = {
		{
			.kind = shady::Stage.COMPUTE,
			.entry = "computeMain",
			.params = "ComputeIn input",
			.returns = "void",
			.body = "return;\n",
			.body_file = "cluster",
			.threads = "64, 1, 1",
		},
	};
	three::ShaderDef def = {
		.name   = "cluster",
		.io     = io,
		.stages = stages,
	};

	DString out;
	out.tinit(8192);
	three::append_shader_def(&out, def, three::ClusterPush);
	String source = out.str_view();

	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the stage kind and its dispatch size are one signature: %s", source);
	test::@check(source.contains("uint3 id @builtin(global_invocation_id);"),
		"and a builtin is a member attribute");
	test::@check(source.contains("struct ClusterPush @pushconstant"), "with the compute pass's own push block");
}

<*
 The second port, and the first compute stage: a module whose only resource is a
 push block, whose structs come from the shared wire list, and whose stage is a
 dispatch. Kong dispatches it and reads the posed vertices back.
*>
fn void the_ported_skin_module_is_generated() @test
{
	String code = three::load_source("shaders/skin.shady")!!;
	defer code.free(mem);

	three::ShaderDef def = three::skin_def(code);

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::SkinPush);
	String source = out.str_view();

	// The stage: a compute entry point at the dispatch size the pass assumes.
	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the workgroup size is part of the signature");
	test::@check(source.contains("uint3 thread @builtin(global_invocation_id);"),
		"and the dispatch thread id is a builtin, not a parameter");
	test::@check(source.contains("skin_vertices(input);"), "the stage body is a call and nothing else");

	// No samplers and no blocks: every buffer this pass touches is an address
	// in the push block, so a module with no resources at all is correct here.
	test::@check(!source.contains("@set("), "a compute pass with no descriptors");

	// The push block is walked from C3, pointers included - the first port where
	// that matters, because this is the first push block to carry any.
	test::@check(source.contains("struct SkinPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("Vec3* positions;") || source.contains("float3* positions;"),
		"a pointer member is a shady pointer to the wire type: %s", source);
	test::@check(source.contains("Instance* instances;") && source.contains("float4x4* baked;"),
		"including pointers to structs and to matrices");
	test::@check(source.contains("uint vertex_count;") && source.contains("uint morph_targets;"),
		"and the scalars the dispatch is sized by");

	// The structs it points at come from the one wire list every module carries.
	test::@check(source.contains("struct SkinnedVertex @address"), "the output is the shared wire struct");
	test::@check(source.contains("struct MorphDelta @address"), "and so are the morph deltas");

	// The port itself.
	test::@check(source.contains("fn void skin_vertices(ComputeIn input)"), "the body survived the port");
	test::@check(source.contains("fn float4x4 blend_joints(float4x4* palette, uint base, uint4 joints, float4 weights)"),
		"a function can take a pointer, which the palette needs");
	test::@check(source.contains("const uint POSE_LIVE = 0x80000000;"), "a constant is a constant");
	test::@check(source.contains("(pose * float4(normal, 0.0)).xyz"),
		"the normal is the w = 0 multiply the original's 3x3 cast spelled out");
	test::@check(source.contains("weights.x * palette[base + joints.x]"),
		"and a matrix scales by a scalar on the left");

	check_compiles(source, "the generated skin module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/skin.shady", source)!!;
}

<*
 Both shadow modules: the depth-only one and the cut-out variant of it.

 The claim that matters here is the one the pair makes together - the vertex path
 is one piece of text handed to both, so the two pipelines cannot pose a vertex
 differently - and the one that separates them: a sampler in the cut-out module
 and none in the other.
*>
fn void the_ported_shadow_modules_are_generated() @test
{
	String code = three::load_source("shaders/shadow.shady")!!;
	defer code.free(mem);
	String cutout_code = three::load_source("shaders/shadow_cutout.shady")!!;
	defer cutout_code.free(mem);

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, three::shadow_def(code), three::ShadowPush);
	String source = out.str_view();

	// The depth-only module: one entry point, no fragment stage, no resources.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the entry point returns the position alone");
	test::@check(source.contains("uint iid @builtin(instance_index);"),
		"and takes the instance id as a builtin");
	test::@check(!source.contains("@fragment"), "a depth pass has no fragment stage");
	test::@check(!source.contains("@set("), "and no descriptors at all");
	test::@check(source.contains("output.sv_position = posed_clip(input.vid, input.iid);"),
		"the stage body is a call to the shared vertex path");

	// The push block and the structs behind it, from C3.
	test::@check(source.contains("struct ShadowPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("float4x4 projection;"), "including the light's clip space");
	test::@check(source.contains("struct DrawRecord @address") && source.contains("struct Instance @address"),
		"and the structs the pass points at are the shared wire ones");

	// The port itself, which both modules share.
	test::@check(source.contains("fn float4 posed_clip(uint vid, uint iid)"), "the body survived the port");
	test::@check(source.contains("(skin_matrix(draw, instance, vid) * float4(position, 1.0)).xyz"),
		"a joint matrix poses a position the same way the draw path poses it");
	test::@check(source.contains("position = draw.posed[iid * draw.skin_stride + vid].position;"),
		"and the pre-skinned path reads the buffer the compute pass wrote");
	test::@check(source.contains("const uint POSE_LIVE = 0x80000000;"), "a constant is a constant");

	check_compiles(source, "the generated shadow module");

	DString cutout;
	cutout.tinit(32768);
	three::append_shader_def(&cutout, three::shadow_cutout_def(code, cutout_code), three::ShadowPush);
	String cutout_source = cutout.str_view();

	// The same vertex path, the same lines - the def handed the same text twice.
	test::@check(cutout_source.contains("fn float4 posed_clip(uint vid, uint iid)"),
		"the cut-out module carries the shared vertex path too");
	test::@check(cutout_source.contains("output.uv = shadow_uv(push.draw[0], push.instances[input.iid], input.vid);"),
		"beside the uv only it carries");

	// The fragment stage, the sampler, and nothing else that changed.
	test::@check(cutout_source.contains("fn void fragmentMain(VertexOutput input) @fragment"),
		"the cut-out variant has the fragment stage");
	test::@check(cutout_source.contains("float2 uv;") && cutout_source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"and a uv on the vertex output");
	test::@check(cutout_source.contains("Sampler2D three_textures[] @set(1) @binding(0);"),
		"the device-wide texture array is what it samples");
	test::@check(cutout_source.contains(".a * draw.base_color.a < draw.surface.w) discard;"),
		"the threshold the draw record already carried decides the discard");

	check_compiles(cutout_source, "the generated shadow cut-out module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/shadow.shady", source)!!;
	file::save("build/shaderdef/shadow_cutout.shady", cutout_source)!!;
}

<*
 The round trip: shady reads back what the def wrote. This is the test that keeps
 the generator honest about a language it writes but does not own, and it is why
 the engine depends on shady at all.
*>
fn void check_compiles(String source, String what)
{
	shady::Diagnostic diagnostic;
	// Scalar layout, because that is the mode the engine compiles in: every
	// struct in a generated module is one of C3's wire structs, and std430
	// would stride them differently - `SkinnedVertex` by 32 rather than 24.
	char[]? spirv = shady::compile(source, &diagnostic, scalar_layout: true);
	if (catch spirv)
	{
		test::@check(false, "%s does not compile: %s", what, diagnostic.to_string(tmem));
		return;
	}
	free(spirv);
}

<*
 The third port, and the second compute stage: light binning, whose outputs are
 three device addresses and an atomic.
*>
fn void the_ported_cluster_module_is_generated() @test
{
	String code = three::load_source("shaders/cluster.shady")!!;
	defer code.free(mem);

	three::ShaderDef def = three::cluster_def(code);

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::ClusterPush);
	String source = out.str_view();

	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the stage is a dispatch at the pass's workgroup size");
	test::@check(source.contains("bin_lights(input);"), "and its body is a call");

	// The push block: four addresses, a matrix, and the scalars the grid and the
	// depth range come from.
	test::@check(source.contains("struct ClusterPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("Light* lights;") && source.contains("uint* counts;")
			&& source.contains("uint* indices;") && source.contains("uint* overflow;"),
		"four device addresses: the lights and the three outputs");
	test::@check(source.contains("float4x4 view_projection;"), "the matrix the planes come from");
	test::@check(source.contains("float4 camera_near;") && source.contains("float far_plane;"),
		"and the near plane and far plane the z slices are laid out with");

	test::@check(source.contains("struct Light @address"), "the light struct is the shared wire one");

	// The port itself.
	test::@check(source.contains("const uint3 grid = uint3(16, 9, 24);"),
		"the grid is a local constant with a vector constructor");
	test::@check(source.contains("float4 planes[4] = { r0 - lo.x * r3, hi.x * r3 - r0, r1 - lo.y * r3, hi.y * r3 - r1 };"),
		"a local array with an initialiser list survived the port");
	test::@check(source.contains("push.indices[cluster * capacity + written++] = i;"),
		"including a postfix increment inside an index");
	test::@check(source.contains("InterlockedAdd(push.overflow[0], 1u);"),
		"and the atomic keeps its HLSL spelling");

	check_compiles(source, "the generated cluster module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/cluster.shady", source)!!;
}
