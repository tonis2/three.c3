<*
 A shader program written from C3.

 The generator's claim is that every declaration in the module is the engine's
 own - the wire structs from `abi.c3`, the push block from a C3 struct, the rest
 from the def - so what is checked here is shape: one module with no markers, no
 macros and no `#ifdef`, every part present and in the place the old templates
 had it, and a body bracketed so a fault inside it names the file its author
 wrote.

 Whether the module *compiles* is shady's question, and the engine depends on
 shady, so it is asked here as well: every module generated by the real defs
 below is handed to the compiler. Kong asks it once more against the Vulkan
 environment, which is where a module can still be wrong after this passes.
*>
module three_tests::shader_def;

import three;
import shady;
import std::core::test;
import std::io;
import std::io::file;
import std::io::path;
import std::core::string;

<*
 One module's text, as a file writes it: the stage interface, a binding, the
 bindless table, a feature, and the entry points - everything the file says for
 itself. The generator adds the prologue above it and nothing else.
*>
const String A_MODULE = `
struct VertexIn
{
	uint vid @builtin(vertex_index);
}

struct VertexOutput
{
	float4 sv_position @position;
	float2 clip;
}

Sampler2D sky_map @set(0) @binding(0);
Sampler2D three_textures[] @set(1) @binding(0);
const bool SHADOWS @spec(0) = true;

fn VertexOutput vertexMain(VertexIn input) @vertex
{
	VertexOutput output;
	return output;
}

fn float4 fragmentMain(VertexOutput input) @fragment
{
	return float4(1.0);
}
`;

<*
 A module through the def: the prologue C3 walks, then the text under its own
 `#line`.

 `three::SkyPush` is the push block because it is the smallest wire struct with
 nothing to point at, which keeps the generated text short enough to read.
*>
macro String emitted_module(String name, String text)
{
	ShaderSource[] sources = { { name, text } };
	ShaderDef def = { .name = "sky", .sources = sources };

	DString out;
	out.tinit(16384);
	three::append_shader_def(&out, def, three::SkyPush);
	return out.str_view();
}

fn void a_def_emits_the_whole_module() @test
{
	String source = emitted_module("sky", A_MODULE);

	// The prologue: a C3 struct that became a block, the variable every entry
	// point reaches it through, and the fields walked from the C3 struct rather
	// than written in the shader.
	test::@check(source.contains("struct SkyPush @pushconstant"), "the push struct is marked\n%s", source);
	test::@check(source.contains("SkyPush push;"), "and a variable of it exists");
	test::@check(source.contains("float4x4 inverse_view_projection;"),
		"walked from the C3 struct rather than written in the shader");

	// The file's own text, verbatim: the generator has nothing to say about a
	// declaration the shader makes for itself.
	test::@check(source.contains("struct VertexOutput\n{\n\tfloat4 sv_position @position;\n\tfloat2 clip;\n}"),
		"stage IO is the file's, unchanged: %s", source);
	test::@check(source.contains("const bool SHADOWS @spec(0) = true;"), "a spec constant too");
	test::@check(source.contains("Sampler2D sky_map @set(0) @binding(0);"), "a resource carries its binding");
	test::@check(source.contains("Sampler2D three_textures[] @set(1) @binding(0);"),
		"and a runtime-sized one is the bindless table");
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the entry points are the file's as well");
	test::@check(source.contains("fn float4 fragmentMain(VertexOutput input) @fragment"), "both of them");
	test::@check(source.contains("#line 1 \"sky\""), "and the file's text is numbered from one");

	// Nothing here is a preprocessor: no markers, no macros, no templating.
	test::@check(!source.contains("#define") && !source.contains("#if") && !source.contains("//@"),
		"and there are no markers and no macros anywhere");
}

<*
 A body is numbered from one under its own name, and the module is numbered again
 after it.

 The restore directive is checked rather than the body's: a directive numbers
 the line that *follows* it, so one written from a template's shape is right
 until a body grows a line, and then points every later diagnostic one line off.
 Counting the physical line here is the same arithmetic the emitter is trusted
 to do.
*>
fn void a_restore_directive_numbers_the_line_after_it() @test
{
	String source = emitted_module("material", A_MODULE);

	uint line = 1;
	usz  at   = 0;
	while (at < source.len)
	{
		usz end = at;
		while (end < source.len && source[end] != '\n') end++;
		String text = source[at:end - at];

		if (text.starts_with("#line "))
		{
			if (text.contains("three."))
			{
				// `#line N "three.sky"` must name the line straight after itself.
				String expected = string::tformat("#line %d \"", line + 1);
				test::@check(text.starts_with(expected),
					"the restore on line %d should number line %d: %s", line, line + 1, text);
			}
			else
			{
				test::@check(text.starts_with("#line 1 \""), "a body is numbered from one: %s", text);
			}
		}
		line++;
		at = end + 1;
	}
	test::@check(source.contains("#line 1 \"material\""), "the body's own name reaches the directive");
}

<*
 The real thing: `sky.slang`'s port, through the def that describes the pass.

 What this writes is what kong compiles and validates - the bridge by which a
 generated module is asked whether it is one before the engine is switched over.
*>
fn void the_ported_sky_module_is_generated() @test
{
	three::ShaderDef def = three::sky_def();

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::SkyPush);
	String source = out.str_view();

	// The ported code, under the file's own name, so a fault inside it is
	// reported in `sky.shady` rather than in the module that generated it.
	test::@check(source.contains("#line 1 \"sky\""), "the ported code is numbered under its own name");
	test::@check(source.contains("fn float2 equirect_uv(float3 direction)"), "the helper survived the port");
	test::@check(source.contains("fn VertexOutput sky_vertex(VertexIn input)"), "and so did the vertex stage");
	test::@check(source.contains("sky_map.Sample(equirect_uv(direction))"),
		"a sampler is a method call, as the rest of the port will be");
	test::@check(source.contains("atan2(direction.x, -direction.z)"),
		"and `atan2` is the builtin rather than a rewritten quadrant case");

	// The generated entry points around it.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the entry point wraps the ported vertex");
	test::@check(source.contains("fn float4 fragmentMain(VertexOutput input) @fragment"),
		"and the fragment entry wraps the fragment");
	test::@check(source.contains("return sky_fragment(input);"), "each stage is a call and nothing else");
	test::@check(!source.contains("#define") && !source.contains("#if") && !source.contains("//@"),
		"with no markers, no macros and no #ifdef anywhere:\n%s", source);

	check_compiles(source, "the generated sky module");

	// And again in kong, against the Vulkan environment rather than the generic
	// one: `spirv-val --target-env vulkan1.3` is the stricter reader, and it is
	// where the ported sky gets drawn.
	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/sky.shady", source)!!;
}

fn void a_compute_stage_carries_its_thread_counts() @test
{
	// The dispatch size is a property of the entry point, so it is written where
	// the entry point is - not in a table on the C3 side that would have to be
	// kept in step with it.
	ShaderSource[] sources = {
		{ "cluster", `
struct ComputeIn
{
	uint3 id @builtin(global_invocation_id);
}

fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)
{
	return;
}
` },
	};
	ShaderDef def = { .name = "cluster", .sources = sources };

	DString out;
	out.tinit(8192);
	three::append_shader_def(&out, def, three::ClusterPush);
	String source = out.str_view();

	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the stage kind and its dispatch size are one signature: %s", source);
	test::@check(source.contains("uint3 id @builtin(global_invocation_id);"),
		"and a builtin is a member attribute");
	test::@check(source.contains("struct ClusterPush @pushconstant"), "with the compute pass's own push block");
}

<*
 A script's uniforms, emitted as the struct a body reads, and the fill that
 reaches it from the push block.

 The emitter's output is checked by compiling it: the struct is spliced into a
 module that has a `Uniforms` member in its push block and a body that reads
 three of its fields - a scalar, a table column indexed by the row, and a name
 that would have been a `#define` once. A field that came out with the wrong type
 or the wrong shape fails here rather than in a script.
*>
fn void a_scripts_uniforms_become_a_typed_struct() @test
{
	MaterialUniform[] uniforms = {
		{ "tint", 4, 1 },
		{ "colors", 4, 8 },
		{ "cells", 1, 1 },
	};
	DString emitted;
	emitted.tinit(512);
	three::append_shady_uniforms(&emitted, uniforms);

	test::@check(emitted.str_view() == `struct Uniforms
{
	float4 tint;
	float4 colors[8];
	float cells;
}

fn Uniforms material_uniforms()
{
	return push.uniforms;
}
`, "the uniform list becomes fields of the shape the list says, and one fill: %s", emitted.str_view());

	String text = string::tformat("%s\n%s", emitted.str_view(), `
struct FragmentIn
{
	float2 uv;
	float4 color;
}

struct StepPush @pushconstant
{
	Uniforms uniforms;
}

StepPush push;

fn float4 frag(FragmentIn input) @fragment
{
	float3 mixed = push.uniforms.tint.rgb * push.uniforms.colors[3].rgb;
	return float4(mixed, push.uniforms.cells);
}
`);

	check_compiles(text, "a module whose body reads its uniforms as fields");
}

fn void a_material_with_no_uniforms_still_has_the_type() @test
{
	// `Surface.uniforms` has to exist for every material, or the body's vocabulary
	// would depend on how many uniforms a script happened to declare. One reserved
	// field is the price. The rows a body may index are not emitted at all: the
	// record carries them, the way it carries the uv table's height.
	DString emitted;
	emitted.tinit(256);
	three::append_shady_uniforms(&emitted, {});

	test::@check(emitted.str_view() == `struct Uniforms
{
	float material_unused;
}

fn Uniforms material_uniforms()
{
	return push.uniforms;
}
`, "no uniforms still declares the type, one reserved field and the fill: %s", emitted.str_view());
}

<*
 A post pass: the header, the four reserved samplers, the triangle, and a body.

 The body is the script's `fragment`, so what this generates is the *fixed* half
 of a post pass - everything a pass has before it says what it does. The
 identity body is what a chain with an effect nobody wrote gets.
*>
macro String identity_post()
{
	return `
fn float3 post(Post p)
{
	return p.color;
}
`;
}

fn void the_ported_post_is_generated() @test
{
	// A post pass with no uniforms of its own: the identity body reads none, and the
	// push block still carries the struct - one field of padding - so a body that
	// reads nothing and a body that reads four floats are the same module shape.
	DString no_uniforms;
	no_uniforms.tinit(128);
	three::append_shady_uniforms(&no_uniforms, {});

	three::ShaderDef def = three::post_def(identity_post(), no_uniforms.str_view());

	DString out;
	out.tinit(16384);
	three::append_shader_def(&out, def, three::PostPush);
	String source = out.str_view();

	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"a post pass has its own entry points: %s", source);
	test::@check(source.contains("float2 uv = float2(float((input.vid << 1) & 2u), float(input.vid & 2u));"),
		"three vertices computed from the vertex index, and no vertex buffer");
	test::@check(source.contains("Sampler2D prev @set(0) @binding(0);") && source.contains("Sampler2D tap_image @set(0) @binding(3);"),
		"the four reserved samplers keep their bindings");
	test::@check(source.contains("p.depth = span > 1e-6 ? near * far / span : far;"),
		"and the depth a body reads is already in world units");
	test::@check(source.contains("return float4(post(p), 1.0);"),
		"with alpha the pass's rather than the body's");
	test::@check(source.contains("fn float3 post(Post p)\n{\n\treturn p.color;"),
		"and the body that was spliced in is the identity");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/post.shady", source)!!;
	check_compiles(source, "the generated post module");
}

<*
 A body that reads both halves of what the merged post pass hands it.

 `p.uniforms` is the struct the script's list emitted, and `p.depth` is the
 reconstruction the fixed half runs before the body - the two things a post
 effect actually keys on. The body is its own source region, ahead of the fixed
 half, so a fault in it is reported at the line the agent typed rather than at
 the line of the module it was spliced into.
*>
macro String graded_post()
{
	return `
fn float3 post(Post p)
{
	float gain = p.uniforms.gain;
	float scale = p.uniforms.near_scale;
	return p.color * p.uniforms.tint.rgb * gain + float3(p.depth * scale);
}
`;
}

fn void a_post_body_reads_its_uniforms_and_its_depth() @test
{
	MaterialUniform[] declared = {
		{ "tint", 3, 1 },
		{ "gain", 1, 1 },
		{ "near_scale", 1, 1 },
	};
	DString uniforms;
	uniforms.tinit(512);
	three::append_shady_uniforms(&uniforms, declared);

	three::ShaderDef def = three::post_def(graded_post(), uniforms.str_view());

	DString out;
	out.tinit(16384);
	three::append_shader_def(&out, def, three::PostPush);
	String source = out.str_view();

	test::@check(source.contains("struct Uniforms\n{\n\tfloat3 tint;\n\tfloat gain;\n\tfloat near_scale;\n}"),
		"the declared list becomes the typed struct above the block: %s", source);
	test::@check(source.contains("p.uniforms = push.uniforms;"),
		"which the fixed half fills from the block");
	test::@check(source.contains("p.depth = span > 1e-6 ? near * far / span : far;"),
		"and `p.depth` is reconstructed before the body runs");
	test::@check(source.contains("float gain = p.uniforms.gain;")
		&& source.contains("float3(p.depth * scale)"),
		"and the body's own text reads both");
	test::@check(source.contains("fn float3 post(Post p)\n{\n\tfloat gain = p.uniforms.gain;"),
		"with the body spliced as a region of its own");
	test::@check(source.index_of("#line 1 \"post_body\"")!! < source.index_of("#line 1 \"post\"")!!,
		"ahead of the fixed half it plugs into");

	check_compiles(source, "a post body reading p.uniforms and p.depth");
}

<*
 The default body: a material nobody wrote. It is the built-in look, and the
 reason the record's own fields are worth asserting on - base colour, roughness
 and emissive all reach the pixels through here.
*>
macro String default_shade()
{
	return `
fn float3 shade(Surface s)
{
	return standard(s);
}
`;
}

<*
 A body that reads its uniforms through `s.uniforms` - the spelling that must not
 move when the storage does. The table column is indexed by the per-copy row, the
 read the old `#define` existed for.
*>
macro String reading_shade()
{
	return `
fn float3 shade(Surface s)
{
	float3 tint = s.uniforms.tint.rgb;
	float3 row = s.uniforms.colors[s.variant].rgb;
	return tint * row * s.uniforms.cells;
}
`;
}

<*
 A whole material module from a declared set, in either storage.

 The same declared list and the same body go into both shapes; only the flag
 differs - the decision `material_spills` makes for a caller, passed to the
 emitter and the def together, so the region above the block and the block itself
 cannot disagree about which one this material got.
*>
macro String material_module(MaterialUniform[] declared, bool spilled, String body, String vertex = "")
{
	DString uniforms;
	uniforms.tinit(1024);
	three::append_shady_uniforms(&uniforms, declared, spilled);

	three::ShaderDef def = three::mesh_def(body, uniforms.str_view(), vertex);
	def.uniforms_spilled = spilled;

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::MeshPush);
	return out.str_view();
}

fn void the_ported_mesh_is_lit() @test
{
	MaterialUniform[] declared = {
		{ "tint", 4, 1 },
		{ "colors", 4, 4 },
	};
	DString uniforms;
	uniforms.tinit(256);
	three::append_shady_uniforms(&uniforms, declared);

	three::ShaderDef def = three::mesh_def(default_shade(), uniforms.str_view(), built_in: true);

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::MeshPush);
	String source = out.str_view();

	test::@check(source.contains("const bool MATERIAL_BUILT_IN = true;"),
		"the marker that says this is the built-in draw path is in the module");
	test::@check(source.contains("fn LightTerms shade_lights("), "the lighting block is carried");
	test::@check(source.contains("uint cluster = fragment_cluster(frame, screen_position, position);"),
		"and the cluster a fragment is lit by is the culling pass's own index");
	test::@check(source.contains("frame[0].cluster_indices[cluster * frame[0].cluster_grid.w + local]"),
		"read out of the frame block's list, overflow bit and all");
	test::@check(source.contains("if (light.meta.z != LIGHT_DIRECTIONAL) continue;"),
		"directionals come from the frame's list, punctuals from the cluster");

	// The half's own seam: the record becomes a Surface, the surface goes to the
	// body, and the body is text that was spliced in rather than a file.
	// The merge: the emitted struct stands above the push block, which carries one
	// member of it, and the body reaches it through the surface.
	sz uniforms_at = source.index_of("struct Uniforms")!!;
	sz push_at = source.index_of("struct MeshPush @pushconstant")!!;
	test::@check(uniforms_at < push_at,
		"the uniforms struct is declared before the push block that holds one");
	test::@check(source.contains("\tUniforms uniforms;\n}\nMeshPush push;"),
		"and the walked block carries it as its last member");
	test::@check(source.contains("fn Uniforms material_uniforms()\n{\n\treturn push.uniforms;\n}"),
		"a push-resident set is returned from the block by the generated fill");
	test::@check(source.contains("s.uniforms = material_uniforms();"),
		"which is where the surface's uniforms come from, storage and all");

	test::@check(source.contains("fn float4 mesh_fragment(VertexOutput input, bool front_facing)"),
		"the material half defines the function the geometry half declared");
	test::@check(source.contains("bool front_facing @builtin(front_facing);"),
		"and the fragment entry takes the rasteriser's flag as its own parameter");
	test::@check(source.contains("s.albedo = draw.base_color.rgb * srgb_to_linear(input.color.rgb);"),
		"the record's base colour and the copy's colour reach the surface");
	test::@check(source.contains("if (MATERIAL_BUILT_IN && (draw.flags & FLAG_COLORS_ARE_MASK) == 0)")
		&& source.contains("s.albedo *= input.vertex_color.rgb;"),
		"and the built-in path folds COLOR_0 into the albedo, leaving a mask alone");
	test::@check(source.contains("s.vertex_mask = (draw.flags & FLAG_HAS_COLORS) != 0"),
		"a body reads the same attribute as a weight through `Surface.vertex_mask`");
	test::@check(source.contains("s.uv = input.uv * draw.uv_transform.xy + draw.uv_transform.zw;"),
		"and the tiling is applied where a body's own sampling lands on the same texel");
	test::@check(source.contains("Sampler2D three_textures[] @set(1) @binding(0);"),
		"the device-wide texture array is the module's one resource");
	test::@check(source.contains("Map base_color_map = map_at(SLOT_BASE_COLOR);"),
		"the base colour map is reached by its row through `Map`");
	test::@check(source.contains("if (base.a * draw.base_color.a < draw.surface.w) discard;"),
		"and the alpha test is before the body, on the map's alpha times the material's");
	test::@check(source.contains("if ((draw.flags & FLAG_HAS_NORMAL_MAP) != 0)")
		&& source.contains("s.normal = mapped_normal_frame(geometric, s.position, s.uv, texel);"),
		"a normal map bends the shading normal through the shared frame, not the geometric one");
	test::@check(source.contains("surface.x *= pair.x;") && source.contains("surface.y *= pair.y;"),
		"the metallic-roughness map multiplies the material's own roughness and metalness");
	test::@check(source.contains("occlusion = scattered"),
		"the occlusion map reaches the crevice the ambient terms scale by");
	test::@check(source.contains("emissive *= scattered"),
		"and the emissive map multiplies what the record set");
	test::@check(source.contains("Sampler2DShadow shadow_atlas_compare        @set(0) @binding(18);")
		&& source.contains("Sampler2DShadow shadow_atlas_static_compare @set(0) @binding(21);"),
		"the shadow atlases are declared at the bindings the pass already writes");
	test::@check(source.contains("s.shadow = shadow_factor(s.position, geometric);"),
		"the surface carries the sun's visibility, read once from the geometric normal");
	test::@check(source.contains("float visibility = i == 0u ? sun_shadow : point_shadow_factor(i, light, position, receiver_normal);"),
		"and the direct light folds it in, the sun from the surface and every other light from its own view");
	test::@check(source.contains("Sampler2D ambient_occlusion_depth @set(0) @binding(4);"),
		"the frame depth the crevice reads is declared at the engine's own binding");
	test::@check(source.contains("s.crevice = occlusion * crevice_occlusion(s.position, geometric);"),
		"the surface carries the crevice the ambient terms scale by");
	test::@check(source.contains("float3 diffuse = ambient * s.crevice")
		&& source.contains("+ push.frame[0].world.rgb * s.crevice;"),
		"and the ambient floor and the world light are what it multiplies");
	test::@check(source.contains("Sampler2D lightmap_atlas @set(0) @binding(20);"),
		"the baked atlas is declared at the engine's own binding");
	test::@check(source.contains("s.lightmapped = front_facing && input.lightmap.z > 0.5;")
		&& source.contains("lightmap_atlas.SampleLevel(input.lightmap.xy, 0.0).rgb"),
		"front faces with a tile read it once, and back faces fall back to real time");
	test::@check(source.contains("if (!(skip_baked_diffuse && light_is_baked(light))) terms.diffuse += energy * nl;"),
		"a baked light's diffuse is skipped where the tile carries it and its highlight is not");
	test::@check(source.contains("baked_dynamic_delta(push.frame, s.normal, s.receiver_normal, s.position)"),
		"and the moving-caster delta is added beside the tile");
	test::@check(source.contains("Sampler2D environment_map @set(0) @binding(2);"),
		"the environment is declared at the engine's own binding");
	test::@check(source.contains("environment_map.SampleLevel(environment_uv(reflected), lod).rgb"),
		"and the reflection samples it through the same mapping the sky background draws with");
	test::@check(source.contains("+ environment_light(s.normal, s.position, s.albedo, s.roughness, s.metalness, s.reflectance) * s.crevice"),
		"the reflection is added beside the direct term and scaled by the crevice");
	test::@check(source.contains("Sampler2D shadow_atlas @set(0) @binding(17);"),
		"the unfiltered shadow map the shadowMap view draws is declared at its reserved binding");
	test::@check(source.contains("if (debug_view(s.position, s.normal, view)) return float4(view, 1.0);"),
		"and a debug view answers instead of the body, before the body runs");
	test::@check(source.contains("float alpha = draw.base_color.a * input.color.a;")
		&& source.contains("alpha *= input.vertex_color.a;")
		&& source.contains("return float4(shade(s), alpha);"),
		"the alpha is the material's and the copy's - plus the attribute's under the built-in path - and never the body's");
	test::@check(source.contains("fn float3 shade(Surface s)\n{\n\treturn standard(s);"),
		"and the body that was spliced in is the one that runs");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/mesh_lit.shady", source)!!;
	check_compiles(source, "the generated lit mesh module");
}

<*
 The push-resident shape: the declared set is a `Uniforms` member of the walked
 block, and the generated fill reads it from there.
*>
fn void a_push_resident_material_fills_uniforms_from_the_block() @test
{
	MaterialUniform[] declared = {
		{ "tint", 4, 1 },
		{ "colors", 4, 4 },
		{ "cells", 1, 1 },
	};
	test::@check(!three::material_spills(declared), "this set fits the push block");

	String source = material_module(declared, false, reading_shade());

	test::@check(source.contains("struct Uniforms\n{\n\tfloat4 tint;\n\tfloat4 colors[4];\n\tfloat cells;\n}"),
		"the struct is the one the fields declared: %s", source);
	test::@check(source.contains("fn Uniforms material_uniforms()\n{\n\treturn push.uniforms;\n}"),
		"and the fill returns the block's member");
	test::@check(source.contains("\tUniforms uniforms;\n}\nMeshPush push;"),
		"which the push block carries by value");
	test::@check(source.contains("s.uniforms = material_uniforms();"),
		"and the surface is filled through the one line, not the storage");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/material_pushed.shady", source)!!;
	check_compiles(source, "the push-resident material module");
}

<*
 The spilled shape: the same struct lives in a device buffer, marked `@address`
 as a pointer target must be, and the push block carries only the pointer.
*>
fn void a_spilled_material_fills_uniforms_from_the_table() @test
{
	MaterialUniform[] declared = {
		{ "tint", 4, 1 },
		{ "colors", 4, 32 },
		{ "cells", 1, 1 },
	};
	test::@check(three::material_spills(declared), "this set outgrows the push block");

	String source = material_module(declared, true, reading_shade());

	test::@check(source.contains("struct Uniforms @address\n{\n\tfloat4 tint;\n\tfloat4 colors[32];\n\tfloat cells;\n}"),
		"the same fields, the same lengths, behind a device address: %s", source);
	test::@check(source.contains("fn Uniforms material_uniforms()\n{\n\treturn push.material_table[0];\n}"),
		"and the fill loads the row from the buffer the push block points at");
	test::@check(source.contains("\tUniforms* material_table;\n}\nMeshPush push;"),
		"which is the block's only member for the set, a pointer of the struct's own type");
	test::@check(!source.contains("\tUniforms uniforms;\n}\nMeshPush push;"),
		"and not the set itself");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/material_spilled.shady", source)!!;
	check_compiles(source, "the spilled material module");
}

<*
 The whole point of the storage split: one body, `s.uniforms.<field>`, compiles
 against both shapes.

 The two modules differ above their push blocks and nowhere a body reads. The
 same reading body - scalar, row-indexed table column, scalar - is spliced into
 both, so a spelling that tracked the storage would fail one of them here.
*>
fn void a_body_reading_its_uniforms_compiles_in_both_shapes() @test
{
	MaterialUniform[] pushed = {
		{ "tint", 4, 1 },
		{ "colors", 4, 4 },
		{ "cells", 1, 1 },
	};
	MaterialUniform[] spilled = {
		{ "tint", 4, 1 },
		{ "colors", 4, 32 },
		{ "cells", 1, 1 },
	};

	String pushed_source = material_module(pushed, false, reading_shade());
	String spilled_source = material_module(spilled, true, reading_shade());

	test::@check(pushed_source.contains("s.uniforms.colors[s.variant]")
		&& spilled_source.contains("s.uniforms.colors[s.variant]"),
		"the body's own text is the same in both modules");

	check_compiles(pushed_source, "the same body over the push block");
	check_compiles(spilled_source, "and over the table buffer");
}

<*
 A material's vertex body: the same seam as `shade`, one stage earlier.

 The contract is `material.shady`'s - the `Vertex` struct and the `@required`
 declaration - and the body is text spliced behind it, so a script's `displace`
 and the built-in nobody wrote are one mechanism. What the checks below hold is
 where the call sits: before the model matrix, so the displacement is in object
 space, and before `variant_uv`, so a body that computes its own uv composes with
 the per-copy transform rather than overriding it.
*>
macro String leaning_vertex()
{
	return `
fn void displace(inout Vertex v)
{
	float gain = v.uniforms.gain;
	v.position.y += sin(v.position.x * 3.0 + gain) * 0.25;
	v.normal = normalize(v.normal + float3(0.1, 0.0, 0.0));
	v.uv += float2(0.25, 0.0);
	v.color = float4(float(v.index) * 0.1, 0.0, 0.0, 1.0);
}
`;
}

fn void a_vertex_body_moves_the_vertex_in_object_space() @test
{
	MaterialUniform[] declared = { { "gain", 1, 1 } };
	String source = material_module(declared, false, default_shade(), leaning_vertex());

	// The contract the body is written against, from the material half: the
	// varyings it may move, the per-vertex seed, and the uniform set it reads
	// through the same seam `Surface.uniforms` does.
	test::@check(source.contains("struct Vertex\n{") && source.contains("\tfloat3 position;")
		&& source.contains("\tfloat3 normal;") && source.contains("\tfloat2 uv;")
		&& source.contains("\tfloat4 color;") && source.contains("\tuint variant;")
		&& source.contains("\tuint index;") && source.contains("Uniforms uniforms;"),
		"the body-facing struct is material.shady's: %s", source);
	test::@check(source.contains("fn void displace(inout Vertex v) @required;"),
		"beside the declaration a body satisfies");

	// The splice, the call, and the transform the call has to precede.
	sz body_at  = source.index_of("float gain = v.uniforms.gain;")!!;
	sz call_at  = source.index_of("displace(v);")!!;
	sz model_at = source.index_of("float4 world = instance.model * float4(v.position, 1.0);")!!;
	test::@check(body_at > source.index_of("struct Vertex")!!,
		"the body is spliced behind the contract it defines");
	test::@check(call_at > body_at && model_at > call_at,
		"and the displacement lands in object space, before the model transform");

	// What the body wrote comes back out of the vertex's fields, and what it did
	// not write is the path's own answer.
	test::@check(source.contains("output.normal = (instance.normal * float4(v.normal, 0.0)).xyz;"),
		"the body's normal goes through the instance's normal matrix");
	test::@check(source.contains("output.uv = variant_uv(output.uv, draw.uv_variants[variant]);"),
		"the per-copy uv is applied on top of whatever the body wrote");
	test::@check(source.contains("v.variant = min(instance.variant, draw.material_rows - 1u);"),
		"the row is clamped before the body can read it");
	test::@check(source.contains("v.index = input.vid;"),
		"the vertex number is the per-vertex seed the body gets");
	test::@check(source.contains("v.uniforms = material_uniforms();"),
		"and the uniforms reach it through the one fill the fragment half also uses");
	test::@check(source.contains("output.color = v.color;") && source.contains("output.variant = v.variant;"),
		"the colour and the row the body moved reach the fragment stage");

	check_compiles(source, "a material with a vertex body");
}

<*
 A material that wrote no vertex body still compiles.

 `mesh_vertex` calls `displace` unconditionally, so the def generates the empty
 function the way the caller generates `standard(s)` for a fragment that wrote
 none: the call is folded away, and the module is the one it was before the
 vertex stage existed.
*>
fn void a_material_without_a_vertex_body_moves_nothing() @test
{
	MaterialUniform[] declared = {};
	String source = material_module(declared, false, default_shade());

	test::@check(source.contains("fn void displace(inout Vertex v)\n{\n}"),
		"the def splices the empty function in: %s", source);
	test::@check(source.contains("displace(v);"), "and the call is still there to be folded");
	check_compiles(source, "a material with no vertex body");
}

<*
 **A body's own lines, all the way through.** The map's own unit test is shady's
 - a hand-written `#line 1 "material"` module reported as `material:3:12` - and
 what these three add is the whole way: text in, a generated module, and a
 diagnostic that names the body and counts in it.

 Each body has its fault on the same line of its own text - line 4 - and the
 assembled module's line for it is hundreds higher, so a diagnostic that named
 the module would fail every assertion below.
*>
fn shady::Diagnostic diagnostic_of(String source)
{
	shady::Diagnostic diagnostic;
	char[]? spirv = shady::compile(source, &diagnostic, scalar_layout: true);
	if (catch spirv)
	{
		// expected: the body has a fault in it
	}
	else
	{
		free(spirv);
	}
	return diagnostic;
}

macro String broken_shade()
{
	return `
fn float3 shade(Surface s)
{
	return s.albedo * notAFunction(s.uv);
}
`;
}

macro String broken_displace()
{
	return `
fn void displace(inout Vertex v)
{
	v.position.y += notAFunction(v.position.x);
}
`;
}

macro String broken_post()
{
	return `
fn float3 post(Post p)
{
	return p.color * notAFunction(p.uv);
}
`;
}

fn void a_fragment_body_error_names_the_bodys_own_line() @test
{
	MaterialUniform[] declared = {};
	String source = material_module(declared, false, broken_shade());
	shady::Diagnostic diagnostic = diagnostic_of(source);

	test::@check(diagnostic.kind == shady::DiagnosticKind.ERROR, "the body does not compile");
	test::@check(diagnostic.name == "material",
		"the region is the body's own name; got '%s'", diagnostic.name);
	test::@check(diagnostic.line == 4, "its line is the body's line 4; got %d", diagnostic.line);
	test::@check(diagnostic.line_text == "\treturn s.albedo * notAFunction(s.uv);",
		"and the echoed line is the body's; got '%s'", diagnostic.line_text);
	test::@check(diagnostic.to_string(tmem).contains("material:4:32"),
		"the heading names body coordinates; got '%s'", diagnostic.to_string(tmem));

	diagnostic.free();
}

fn void a_vertex_body_error_names_the_bodys_own_line() @test
{
	MaterialUniform[] declared = {};
	String source = material_module(declared, false, default_shade(), broken_displace());
	shady::Diagnostic diagnostic = diagnostic_of(source);

	test::@check(diagnostic.kind == shady::DiagnosticKind.ERROR, "the body does not compile");
	test::@check(diagnostic.name == "vertex",
		"the region is the vertex body's own name; got '%s'", diagnostic.name);
	test::@check(diagnostic.line == 4, "its line is the body's line 4; got %d", diagnostic.line);
	test::@check(diagnostic.line_text == "\tv.position.y += notAFunction(v.position.x);",
		"and the echoed line is the body's; got '%s'", diagnostic.line_text);
	test::@check(diagnostic.to_string(tmem).contains("vertex:4:30"),
		"the heading names body coordinates; got '%s'", diagnostic.to_string(tmem));

	diagnostic.free();
}

fn void a_post_body_error_names_the_bodys_own_line() @test
{
	MaterialUniform[] declared = { { "gain", 1, 1 } };
	DString uniforms;
	uniforms.tinit(128);
	three::append_shady_uniforms(&uniforms, declared);

	three::ShaderDef def = three::post_def(broken_post(), uniforms.str_view());
	DString out;
	out.tinit(16384);
	three::append_shader_def(&out, def, three::PostPush);
	shady::Diagnostic diagnostic = diagnostic_of(out.str_view());

	test::@check(diagnostic.kind == shady::DiagnosticKind.ERROR, "the body does not compile");
	test::@check(diagnostic.name == "post_body",
		"the region is the post body's own name; got '%s'", diagnostic.name);
	test::@check(diagnostic.line == 4, "its line is the body's line 4; got %d", diagnostic.line);
	test::@check(diagnostic.line_text == "\treturn p.color * notAFunction(p.uv);",
		"and the echoed line is the body's; got '%s'", diagnostic.line_text);
	test::@check(diagnostic.to_string(tmem).contains("post_body:4:31"),
		"the heading names body coordinates; got '%s'", diagnostic.to_string(tmem));

	diagnostic.free();
}

<*
 The second port, and the first compute stage: a module whose only resource is a
 push block, whose structs come from the shared wire list, and whose stage is a
 dispatch. Kong dispatches it and reads the posed vertices back.
*>
fn void the_ported_skin_module_is_generated() @test
{
	three::ShaderDef def = three::skin_def();

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::SkinPush);
	String source = out.str_view();

	// The stage: a compute entry point at the dispatch size the pass assumes.
	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the workgroup size is part of the signature");
	test::@check(source.contains("uint3 thread @builtin(global_invocation_id);"),
		"and the dispatch thread id is a builtin, not a parameter");
	test::@check(source.contains("skin_vertices(input);"), "the stage body is a call and nothing else");

	// No samplers and no blocks: every buffer this pass touches is an address
	// in the push block, so a module with no resources at all is correct here.
	test::@check(!source.contains("@set("), "a compute pass with no descriptors");

	// The push block is walked from C3, pointers included - the first port where
	// that matters, because this is the first push block to carry any.
	test::@check(source.contains("struct SkinPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("Vec3* positions;") || source.contains("float3* positions;"),
		"a pointer member is a shady pointer to the wire type: %s", source);
	test::@check(source.contains("Instance* instances;") && source.contains("float4x4* baked;"),
		"including pointers to structs and to matrices");
	test::@check(source.contains("uint vertex_count;") && source.contains("uint morph_targets;"),
		"and the scalars the dispatch is sized by");

	// The structs it points at come from the one wire list every module carries.
	test::@check(source.contains("struct SkinnedVertex @address"), "the output is the shared wire struct");
	test::@check(source.contains("struct MorphDelta @address"), "and so are the morph deltas");

	// The port itself.
	test::@check(source.contains("fn void skin_vertices(ComputeIn input)"), "the body survived the port");
	test::@check(source.contains("fn float4x4 blend_joints(float4x4* palette, uint base, uint4 joints, float4 weights)"),
		"a function can take a pointer, which the palette needs");
	test::@check(source.contains("const uint POSE_LIVE = 0x80000000;"), "a constant is a constant");
	test::@check(source.contains("(pose * float4(normal, 0.0)).xyz"),
		"the normal is the w = 0 multiply the original's 3x3 cast spelled out");
	test::@check(source.contains("weights.x * palette[base + joints.x]"),
		"and a matrix scales by a scalar on the left");

	check_compiles(source, "the generated skin module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/skin.shady", source)!!;
}

<*
 The draw path's varyings, returned instead of shaded.

 The fragment stage that runs is the real material half's; what this stub
 replaces is only the *look*, so a drawing test can read the interpolated
 varyings back out of a colour attachment. `Surface.uv` is the material's own uv
 transform applied to the mesh's, which the kong rig sets to the identity, so
 the red and green channels are the vertex stage's uv and blue is the instance's
 own tint. The material half replaces this - which is why the def takes it as an
 argument rather than writing it.
*>
macro String mesh_test_shade()
{
	return `
fn float3 shade(Surface s)
{
	return float3(s.uv, s.color.g);
}
`;
}

fn void the_ported_mesh_module_is_generated() @test
{
	String geometry = three::load_source("shaders/mesh.shady")!!;
	defer geometry.free(mem);

	DString uniforms;
	uniforms.tinit(128);
	three::append_shady_uniforms(&uniforms, {});

	three::ShaderDef def = three::mesh_def(mesh_test_shade(), uniforms.str_view());

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::MeshPush);
	String source = out.str_view();

	// One module, two entry points: the shape `MESH_ENTRIES` and the pipeline
	// layouts are built from.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the vertex stage takes the two builtins");
	test::@check(source.contains("uint vid @builtin(vertex_index);") && source.contains("uint iid @builtin(instance_index);"),
		"as builtins rather than as vertex attributes");
	test::@check(source.contains("fn float4 fragmentMain(VertexOutput input, FragmentFace face) @fragment"),
		"and the fragment stage is the second entry point, with the front-face builtin beside it");

	// The varyings are the wire format between the two halves, in the order the
	// material half declares them.
	test::@check(source.contains("float3 normal;") && source.contains("float2 uv;")
		&& source.contains("float3 world;") && source.contains("float4 vertex_color;")
		&& source.contains("float3 lightmap;") && source.contains("float4 sv_position @position;"),
		"every varying the fragment half reads is declared here");
	sz normal_at = source.index_of("float3 normal;")!!;
	sz world_at  = source.index_of("float3 world;")!!;
	test::@check(normal_at < world_at, "and in the material half's order");

	// The push block is the C3 struct the pass fills, and the structs behind it
	// are the shared wire ones.
	test::@check(source.contains("struct MeshPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("DrawRecord* draw;") && source.contains("Instance* instances;"),
		"which points at this bucket's record and its instances");
	test::@check(source.contains("struct FrameBlock @address") && source.contains("struct MorphDelta @address"),
		"and the structs behind it come from one wire list for every module");

	// The port itself.
	test::@check(source.contains("fn void mesh_vertex(VertexIn input, out VertexOutput output)"),
		"the vertex path survived the port");
	test::@check(source.contains("pose_vertex(draw, instance, input.vid, input.iid, position, normal);"),
		"and calls the pose the shadow pass calls");
	test::@check(source.contains("fn void pose_vertex("), "which is carried as a source block of its own");
	test::@check(source.contains("output.uv = variant_uv(output.uv, draw.uv_variants[variant]);"),
		"the per-copy uv is applied in the vertex stage, where it is exact");
	test::@check(source.contains("if (draw.lightmap_uvs) lightmap_uv = draw.lightmap_uvs[input.vid];"),
		"and an absent stream is guarded by a null check rather than zero-filled");

	// The vertex body's seam: the contract from the material half, the empty
	// function standing in for a body nobody wrote, and the call between the
	// pose and the model transform.
	test::@check(source.contains("struct Vertex\n{") && source.contains("\tfloat3 position;")
		&& source.contains("\tfloat3 normal;") && source.contains("\tfloat2 uv;")
		&& source.contains("\tfloat4 color;") && source.contains("\tfloat4 vertex_color;")
		&& source.contains("\tuint variant;"),
		"the body-facing struct is declared by the material half");
	test::@check(source.contains("fn void displace(inout Vertex v) @required;"),
		"beside the declaration a body satisfies");
	test::@check(source.contains("fn void displace(inout Vertex v)\n{\n}"),
		"and the def splices the empty function in when the material wrote none");
	test::@check(source.contains("displace(v);"), "which the vertex path calls unconditionally");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/mesh.shady", source)!!;
	check_compiles(source, "the generated mesh module");
}

<*
 Both shadow modules: the depth-only one and the cut-out variant of it.

 The claim that matters here is the one the pair makes together - the vertex path
 is one piece of text handed to both, so the two pipelines cannot pose a vertex
 differently - and the one that separates them: a sampler in the cut-out module
 and none in the other.
*>
fn void the_ported_shadow_modules_are_generated() @test
{
	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, three::shadow_def(), three::ShadowPush);
	String source = out.str_view();

	// The depth-only module: one entry point, no fragment stage, no resources.
	test::@check(source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"the entry point returns the position alone");
	test::@check(source.contains("uint iid @builtin(instance_index);"),
		"and takes the instance id as a builtin");
	test::@check(!source.contains("@fragment"), "a depth pass has no fragment stage");
	test::@check(!source.contains("@set("), "and no descriptors at all");
	test::@check(source.contains("output.sv_position = posed_clip(input.vid, input.iid);"),
		"the stage body is a call to the shared vertex path");

	// The push block and the structs behind it, from C3.
	test::@check(source.contains("struct ShadowPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("float4x4 projection;"), "including the light's clip space");
	test::@check(source.contains("struct DrawRecord @address") && source.contains("struct Instance @address"),
		"and the structs the pass points at are the shared wire ones");

	// The port itself, which both modules share.
	test::@check(source.contains("fn float4 posed_clip(uint vid, uint iid)"), "the body survived the port");
	test::@check(source.contains("pose_vertex(draw, instance, vid, iid, position, unused_normal);"),
		"the pose is the shared block's, not a copy of it");
	test::@check(source.contains("(pose * float4(position, 1.0)).xyz")
		&& source.contains("draw.posed[iid * draw.skin_stride + vid]"),
		"and that block carries both skinning paths, unchanged");
	test::@check(source.contains("const uint POSE_LIVE = 0x80000000;"), "a constant is a constant");

	check_compiles(source, "the generated shadow module");

	DString cutout;
	cutout.tinit(32768);
	three::append_shader_def(&cutout, three::shadow_cutout_def(), three::ShadowPush);
	String cutout_source = cutout.str_view();

	// The same vertex path, the same lines - the def handed the same text twice.
	test::@check(cutout_source.contains("fn float4 posed_clip(uint vid, uint iid)"),
		"the cut-out module carries the shared vertex path too");
	test::@check(cutout_source.contains("output.uv = shadow_uv(push.draw[0], push.instances[input.iid], input.vid);"),
		"beside the uv only it carries");

	// The fragment stage, the sampler, and nothing else that changed.
	test::@check(cutout_source.contains("fn void fragmentMain(CutoutOutput input) @fragment") && cutout_source.contains("fn CutoutOutput cutoutVertexMain(VertexIn input) @vertex"),
		"the cut-out variant has the fragment stage");
	test::@check(cutout_source.contains("float2 uv;") && cutout_source.contains("fn VertexOutput vertexMain(VertexIn input) @vertex"),
		"and a uv on the vertex output");
	test::@check(cutout_source.contains("Sampler2D three_textures[] @set(1) @binding(0);"),
		"the device-wide texture array is what it samples");
	test::@check(cutout_source.contains(".a * draw.base_color.a < draw.surface.w) discard;"),
		"the threshold the draw record already carried decides the discard");

	check_compiles(cutout_source, "the generated shadow cut-out module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/shadow.shady", source)!!;
	file::save("build/shaderdef/shadow_cutout.shady", cutout_source)!!;
}

<*
 The round trip: shady reads back what the def wrote. This is the test that keeps
 the generator honest about a language it writes but does not own, and it is why
 the engine depends on shady at all.
*>
fn void check_compiles(String source, String what)
{
	shady::Diagnostic diagnostic;
	// Scalar layout, because that is the mode the engine compiles in: every
	// struct in a generated module is one of C3's wire structs, and std430
	// would stride them differently - `SkinnedVertex` by 32 rather than 24.
	char[]? spirv = shady::compile(source, &diagnostic, scalar_layout: true);
	if (catch spirv)
	{
		test::@check(false, "%s does not compile: %s", what, diagnostic.to_string(tmem));
		return;
	}
	free(spirv);
}

<*
 The third port, and the second compute stage: light binning, whose outputs are
 three device addresses and an atomic.
*>
fn void the_ported_cluster_module_is_generated() @test
{
	three::ShaderDef def = three::cluster_def();

	DString out;
	out.tinit(32768);
	three::append_shader_def(&out, def, three::ClusterPush);
	String source = out.str_view();

	test::@check(source.contains("fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)"),
		"the stage is a dispatch at the pass's workgroup size");
	test::@check(source.contains("bin_lights(input);"), "and its body is a call");

	// The push block: four addresses, a matrix, and the scalars the grid and the
	// depth range come from.
	test::@check(source.contains("struct ClusterPush @pushconstant"), "the push block is the C3 struct");
	test::@check(source.contains("Light* lights;") && source.contains("uint* counts;")
			&& source.contains("uint* indices;") && source.contains("uint* overflow;"),
		"four device addresses: the lights and the three outputs");
	test::@check(source.contains("float4x4 view_projection;"), "the matrix the planes come from");
	test::@check(source.contains("float4 camera_near;") && source.contains("float far_plane;"),
		"and the near plane and far plane the z slices are laid out with");

	test::@check(source.contains("struct Light @address"), "the light struct is the shared wire one");

	// The port itself.
	test::@check(source.contains("const uint3 grid = uint3(16, 9, 24);"),
		"the grid is a local constant with a vector constructor");
	test::@check(source.contains("float4 planes[4] = { r0 - lo.x * r3, hi.x * r3 - r0, r1 - lo.y * r3, hi.y * r3 - r1 };"),
		"a local array with an initialiser list survived the port");
	test::@check(source.contains("push.indices[cluster * capacity + written++] = i;"),
		"including a postfix increment inside an index");
	test::@check(source.contains("InterlockedAdd(push.overflow[0], 1u);"),
		"and the atomic keeps its HLSL spelling");

	check_compiles(source, "the generated cluster module");

	path::mkdir("build/shaderdef", recursive: true)!!;
	file::save("build/shaderdef/cluster.shady", source)!!;
}
