// three.c3 shadow pass, ported to shady for the ShaderDef generator
// (`src/shader/shadow.c3`).
//
// The declarations are gone: the push block comes from the C3 `ShadowPush` the
// pass fills, and the structs it points at come from `abi.c3`'s wire list. What
// is left is the constants and the vertex path - where one vertex of one copy
// lands in the light's clip space.
//
// **This file is the vertex half of both shadow pipelines.** The cut-out variant
// is a second module (`shaders/shadow_cutout.shady`) because shady has no
// preprocessor, and the def hands this same text to both: a pose that drifted
// between the pipeline every caster shares and the one that cuts would be a leaf
// whose shadow is cast from a different place than its neighbours.
//
// What the original says about the shape still holds:
//
//  - depth is a function of position, so no normal and no colour ride along, and
//    a uv rides along only in the cut-out module;
//  - **a `ShaderMaterial` with a `vertex:` body is not run here**, so such a mesh
//    casts the shadow of its undisplaced geometry. Fixing it means a shadow
//    pipeline per material, which is why it is stated rather than done;
//  - the morph runs before the skin and never after: a blend shape is authored
//    against the rest mesh, and a displacement applied to a vertex the joints
//    have already moved would swing with the limb;
//  - the two skinning paths are here for the same reason the body is: a
//    character's shadow has to be the shadow of the pose it is wearing.

const uint FLAG_HAS_NORMALS = 1;
const uint FLAG_HAS_UVS = 2;
const uint FLAG_HAS_COLORS = 4;
const uint FLAG_HAS_SKIN = 8;
const uint FLAG_PRESKINNED = 16;

const uint POSE_LIVE = 0x80000000;
const uint POSE_MASK = 0x7fffffff;

// The four influences of one vertex against one palette, summed into the matrix
// that poses it. Split out so a crossfade can spend it twice - the two frames a
// fade sits between are two offsets into one buffer.
fn float4x4 blend_joints(float4x4* palette, uint base, uint4 joints, float4 weights)
{
	return weights.x * palette[base + joints.x]
	     + weights.y * palette[base + joints.y]
	     + weights.z * palette[base + joints.z]
	     + weights.w * palette[base + joints.w];
}

// The four influences of one vertex, blended into the matrix that poses it. The
// same function `mesh.shady` carries, and it has to be: a shadow cast from a
// different blend is a character whose shadow walks out of step with it.
fn float4x4 skin_matrix(DrawRecord draw, Instance instance, uint vid)
{
	float4x4* palette = draw.palette;
	if ((instance.pose & POSE_LIVE) != 0) palette = push.frame[0].live_poses;
	uint base = instance.pose & POSE_MASK;

	uint4 joints = draw.joints[vid];
	float4 weights = draw.weights[vid];

	float4x4 pose = blend_joints(palette, base, joints, weights);
	// Uniform across an instance, so this is a scalar branch. The mix is of joint
	// matrices and not of the transforms behind them: `mesh.shady` names that lie
	// and argues for it, and this pass has to make the same trade or a character's
	// shadow fades out of step with the character.
	if (instance.blend <= 0.0) return pose;

	float4x4 from = blend_joints(palette, instance.pose_from & POSE_MASK, joints, weights);
	return pose + (from - pose) * instance.blend;
}

// The base vertex, displaced by every morph target this bucket carries.
fn void apply_morph(DrawRecord draw, Instance instance, uint vid, inout float3 position, inout float3 normal)
{
	if (draw.morph_targets == 0 || instance.morph == 0) return;

	// Stored plus one, so zero can mean "this copy does not morph" - which is what
	// a copy whose weights were cleared carries, and every copy of every unmorphed
	// mesh with it.
	uint base = instance.morph - 1;

	for (uint t = 0; t < draw.morph_targets; t++)
	{
		float weight = push.frame[0].morph_weights[base + t];
		// Skipped rather than multiplied by zero: a face wears two of its twenty
		// expressions, so the branch is taken far more often than not and costs one
		// compare against two multiply-adds and a 24-byte read.
		if (weight == 0.0) continue;

		MorphDelta delta = draw.morph[t * draw.skin_stride + vid];
		position += weight * delta.position;
		normal += weight * delta.normal;
	}
}

// Where one vertex of one copy lands in the light's clip space.
//
// Split out of the entry points because there are two of them: the depth-only
// one and the cut-out one, which needs a uv beside the position. Both have to
// pose a vertex identically.
fn float4 posed_clip(uint vid, uint iid)
{
	DrawRecord draw = push.draw[0];
	Instance instance = push.instances[iid];

	float3 position = draw.positions[vid];

	// A shadow has to be cast by the face the character is wearing, so the same
	// displacement runs here. `normal` is a discard - this pass has none, and the
	// shared function writes one.
	float3 unused_normal = float3(0.0, 1.0, 0.0);
	apply_morph(draw, instance, vid, position, unused_normal);

	// The two skinning paths, in the same order and with the same exclusivity the
	// draw path states: one flag or the other, never both. An `if` rather than a
	// ternary, because one of the two pointers is null on any given draw.
	if ((draw.flags & FLAG_HAS_SKIN) != 0)
	{
		position = (skin_matrix(draw, instance, vid) * float4(position, 1.0)).xyz;
	}
	else if ((draw.flags & FLAG_PRESKINNED) != 0)
	{
		position = draw.posed[iid * draw.skin_stride + vid].position;
	}

	// Model first, light second - the same order the main pass uses with the
	// camera, and the only order that makes sense: a joint matrix is in the
	// character's space, the model matrix puts the character in the world, and the
	// light looks at the world.
	return push.projection * (instance.model * float4(position, 1.0));
}
