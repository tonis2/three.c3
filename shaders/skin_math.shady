// Dual-quaternion skinning, shared by the compute pass and the draw/shadow pass.
//
// `skin.shady` and `skinning.shady` both import this file, so `blend_joints`
// exists once in the repository rather than once per module. It is the one
// function the two passes must agree on to the bit — a compute pass that posed a
// vertex differently from the draw that consumes it, or a shadow cast from a
// different pose than the body, is a bug invisible in either one alone.
//
// The blend is of the joints' rigid transforms as DUAL QUATERNIONS, not an
// average of their matrices. Averaging the matrices (plain linear-blend skinning)
// collapses a twisted limb toward its bone axis — the "candy-wrapper" pinch;
// blending the transforms keeps the cross-section round through a twist. The
// palette the callers hand in is unchanged: each matrix is split back into the
// rotation and translation it was composed from, blended, and rebuilt.
//
// Nothing here reads a push block or a wire struct, so it is the same in both
// passes and depends on neither's ABI.

// A rigid palette matrix's rotation as a quaternion (x, y, z, w). shady indexes a
// matrix by column, so the basis is m[0..2].xyz and the trace method reads it
// straight. The palette is rotation-and-translation only — no scale — so the
// columns are orthonormal and the four-case form is exact and stable.
fn float4 rotation_quat(float4x4 m)
{
	float3 cx = m[0].xyz;
	float3 cy = m[1].xyz;
	float3 cz = m[2].xyz;
	float t;
	float4 q;
	if (cz.z < 0.0)
	{
		if (cx.x > cy.y)
		{
			t = 1.0 + cx.x - cy.y - cz.z;
			q = float4(t, cy.x + cx.y, cz.x + cx.z, cy.z - cz.y);
		}
		else
		{
			t = 1.0 - cx.x + cy.y - cz.z;
			q = float4(cy.x + cx.y, t, cz.y + cy.z, cz.x - cx.z);
		}
	}
	else
	{
		if (cx.x < -cy.y)
		{
			t = 1.0 - cx.x - cy.y + cz.z;
			q = float4(cz.x + cx.z, cz.y + cy.z, t, cx.y - cy.x);
		}
		else
		{
			t = 1.0 + cx.x + cy.y + cz.z;
			q = float4(cy.z - cz.y, cz.x - cx.z, cx.y - cy.x, t);
		}
	}
	return q * (0.5 * rsqrt(t));
}

// Hamilton product of two quaternions, vector part first.
fn float4 quat_mul(float4 a, float4 b)
{
	return float4(
		a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
		a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
		a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z);
}

// One influence added into a dual-quaternion sum, its rotation first turned into
// `pivot`'s hemisphere so the blend takes the short arc: the antipodal quaternion
// is the same rotation but averages the long way. The dual part carries the
// translation: 0.5 * (t as a pure quaternion) * r.
fn void add_influence(float4x4 m, float weight, float4 pivot, inout float4 real, inout float4 dual)
{
	float4 r = rotation_quat(m);
	if (dot(pivot, r) < 0.0) r = -r;
	real = real + weight * r;
	dual = dual + weight * (0.5 * quat_mul(float4(m[3].xyz, 0.0), r));
}

// A summed dual quaternion back to the rotation-and-translation matrix it stands
// for, normalised once. `fallback` is what a sum of nothing comes back as.
fn float4x4 rebuild(float4 real, float4 dual, float4x4 fallback)
{
	float scale = length(real);
	// Zero only if every weight is zero, which a skinned vertex never is; fall
	// back to the first influence rather than normalize a zero quaternion.
	if (scale < 0.00000001) return fallback;
	real = real / scale;
	dual = dual / scale;

	float qx = real.x;
	float qy = real.y;
	float qz = real.z;
	float qw = real.w;
	float x2 = qx + qx;
	float y2 = qy + qy;
	float z2 = qz + qz;
	float xx = qx * x2;
	float xy = qx * y2;
	float xz = qx * z2;
	float yy = qy * y2;
	float yz = qy * z2;
	float zz = qz * z2;
	float wx = qw * x2;
	float wy = qw * y2;
	float wz = qw * z2;

	float4 col0 = float4(1.0 - (yy + zz), xy + wz, xz - wy, 0.0);
	float4 col1 = float4(xy - wz, 1.0 - (xx + zz), yz + wx, 0.0);
	float4 col2 = float4(xz + wy, yz - wx, 1.0 - (xx + yy), 0.0);
	float3 translation = 2.0 * quat_mul(dual, float4(-real.x, -real.y, -real.z, real.w)).xyz;
	float4 col3 = float4(translation, 1.0);

	return float4x4(col0, col1, col2, col3);
}

// The four influences of one vertex at two baked frames of a clip, `t` of the way
// from the first to the second, blended into the matrix that poses it — eight
// influences in one dual-quaternion sum, every rotation in the first one's
// hemisphere, normalised once. So between two frames the vertex moves along the
// rigid path between them rather than through a mix of their matrices, and a
// clip baked at thirty frames a second plays smoothly at any rate.
fn float4x4 blend_frames(float4x4* palette, uint base, uint next, float t, uint4 joints, float4 weights)
{
	float4x4 first = palette[base + joints.x];
	float4 pivot = rotation_quat(first);
	float4 real = float4(0.0, 0.0, 0.0, 0.0);
	float4 dual = float4(0.0, 0.0, 0.0, 0.0);

	float4 now = weights * (1.0 - t);
	add_influence(first, now.x, pivot, real, dual);
	add_influence(palette[base + joints.y], now.y, pivot, real, dual);
	add_influence(palette[base + joints.z], now.z, pivot, real, dual);
	add_influence(palette[base + joints.w], now.w, pivot, real, dual);

	if (t > 0.0)
	{
		float4 then = weights * t;
		add_influence(palette[next + joints.x], then.x, pivot, real, dual);
		add_influence(palette[next + joints.y], then.y, pivot, real, dual);
		add_influence(palette[next + joints.z], then.z, pivot, real, dual);
		add_influence(palette[next + joints.w], then.w, pivot, real, dual);
	}

	return rebuild(real, dual, first);
}

// The four influences of one vertex against one palette, blended into the matrix
// that poses it — see the file header for why it is dual quaternions. One frame
// of `blend_frames`, and the same arithmetic in the same order.
fn float4x4 blend_joints(float4x4* palette, uint base, uint4 joints, float4 weights)
{
	return blend_frames(palette, base, base, 0.0, joints, weights);
}
