// Dual-quaternion skinning, shared by the compute pass and the draw/shadow pass.
//
// `skin.shady` and `skinning.shady` both import this file, so `blend_joints`,
// `blend_frames`, and `apply_pose` exist once in the repository rather than
// once per module. Both passes read pre-decomposed 32-byte `SkinJoint` records
// (unit quaternion + xyz translation + uniform scale) packed on the CPU, so
// vertices skip matrix decomposition and 4x4 rebuilds.
//
// Weights are sorted descending at load time (`w.x >= w.y >= w.z >= w.w`), so
// `joints.x` is always the dominant pivot and a zero weight terminates the rest.

// Blended rigid transform plus uniform scale, applied directly to vertex vectors.
struct BlendedPose
{
	float4 rot;
	float3 trans;
	float scale;
}

// Hamilton product of two quaternions, vector part first.
fn float4 quat_mul(float4 a, float4 b)
{
	return float4(
		a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
		a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
		a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z);
}

// Rotate a 3-vector by a unit quaternion (x, y, z, w).
fn float3 qrot(float4 q, float3 v)
{
	return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

// One influence added into a dual-quaternion sum, flipped into `pivot`'s
// hemisphere so the blend takes the short arc.
fn void add_joint(SkinJoint j, float w, float4 pivot, inout float4 real, inout float4 dual, inout float size)
{
	float4 r = j.rot;
	if (dot(pivot, r) < 0.0) r = -r;
	real = real + w * r;
	dual = dual + w * (0.5 * quat_mul(float4(j.pos_scale.xyz, 0.0), r));
	size = size + w * j.pos_scale.w;
}

// Normalize a summed dual quaternion once and recover its translation and scale.
fn BlendedPose finalize_pose(float4 real, float4 dual, float size, float total, SkinJoint fallback)
{
	BlendedPose result;
	float norm = length(real);
	if (norm < 0.00000001)
	{
		result.rot = fallback.rot;
		result.trans = fallback.pos_scale.xyz;
		result.scale = fallback.pos_scale.w;
		return result;
	}
	float inv = 1.0 / norm;
	real = real * inv;
	dual = dual * inv;
	result.rot = real;
	result.trans = 2.0 * quat_mul(dual, float4(-real.x, -real.y, -real.z, real.w)).xyz;
	result.scale = total > 0.00000001 ? size / total : 1.0;
	return result;
}

// The four influences of one vertex against one palette (`pose_t == 0`), blended
// into a rigid transform + uniform scale.
fn BlendedPose blend_joints(SkinJoint* palette, uint base, uint4 joints, float4 weights)
{
	SkinJoint first = palette[base + joints.x];
	if (weights.y <= 0.0)
	{
		BlendedPose single;
		single.rot = first.rot;
		single.trans = first.pos_scale.xyz;
		single.scale = first.pos_scale.w;
		return single;
	}

	float4 pivot = first.rot;
	float4 real = weights.x * pivot;
	float4 dual = weights.x * (0.5 * quat_mul(float4(first.pos_scale.xyz, 0.0), pivot));
	float size = weights.x * first.pos_scale.w;

	add_joint(palette[base + joints.y], weights.y, pivot, real, dual, size);
	if (weights.z > 0.0)
	{
		add_joint(palette[base + joints.z], weights.z, pivot, real, dual, size);
		if (weights.w > 0.0)
		{
			add_joint(palette[base + joints.w], weights.w, pivot, real, dual, size);
		}
	}

	float total = weights.x + weights.y + weights.z + weights.w;
	return finalize_pose(real, dual, size, total, first);
}

// The four influences of one vertex at two baked frames, `t` of the way from
// `base` to `next`, blended in one dual-quaternion sum.
fn BlendedPose blend_frames(SkinJoint* palette, uint base, uint next, float t, uint4 joints, float4 weights)
{
	SkinJoint first = palette[base + joints.x];
	float4 pivot = first.rot;

	float4 now = weights * (1.0 - t);
	float4 real = now.x * pivot;
	float4 dual = now.x * (0.5 * quat_mul(float4(first.pos_scale.xyz, 0.0), pivot));
	float size = now.x * first.pos_scale.w;

	if (weights.y > 0.0)
	{
		add_joint(palette[base + joints.y], now.y, pivot, real, dual, size);
		if (weights.z > 0.0)
		{
			add_joint(palette[base + joints.z], now.z, pivot, real, dual, size);
			if (weights.w > 0.0)
			{
				add_joint(palette[base + joints.w], now.w, pivot, real, dual, size);
			}
		}
	}

	if (t > 0.0)
	{
		float4 then = weights * t;
		add_joint(palette[next + joints.x], then.x, pivot, real, dual, size);
		if (weights.y > 0.0)
		{
			add_joint(palette[next + joints.y], then.y, pivot, real, dual, size);
			if (weights.z > 0.0)
			{
				add_joint(palette[next + joints.z], then.z, pivot, real, dual, size);
				if (weights.w > 0.0)
				{
					add_joint(palette[next + joints.w], then.w, pivot, real, dual, size);
				}
			}
		}
	}

	float total = weights.x + weights.y + weights.z + weights.w;
	return finalize_pose(real, dual, size, total, first);
}

// Apply a blended rigid transform + uniform scale directly to position and normal.
fn void apply_pose(BlendedPose pose, inout float3 position, inout float3 normal)
{
	position = pose.scale * qrot(pose.rot, position) + pose.trans;
	normal = pose.scale * qrot(pose.rot, normal);
}
