// Compute skinning pass (`src/shader/skin.c3`).
//
// Dispatched in 2D (`thread.x = vertex`, `thread.y = instance`) so every lane
// in a workgroup shares one instance's pose, eliminating integer division and
// keeping instance fetches wave-uniform. Morph displacement runs before the
// dual-quaternion blend, matching `shaders/skinning.shady`.

import "skin_math.shady";

struct ComputeIn
{
	uint3 thread @builtin(global_invocation_id);
}

const uint FLAG_HAS_NORMALS = 1;
const uint POSE_LIVE = 0x80000000;
const uint POSE_MASK = 0x7fffffff;

fn void skin_vertices(ComputeIn input)
{
	uint vid = input.thread.x;
	uint iid = input.thread.y;
	if (vid >= push.vertex_count || iid >= push.instance_count) return;
	uint index = iid * push.vertex_count + vid;

	// Read individual fields rather than copying the whole `Instance`, which Adreno misreads.
	uint packed_pose = push.instances[iid].pose;
	uint morph = push.instances[iid].morph;

	// An `if` rather than a ternary choice: one of these pointers may be null.
	SkinJoint* palette = push.baked;
	if ((packed_pose & POSE_LIVE) != 0) palette = push.live;
	uint base = packed_pose & POSE_MASK;

	float3 position = push.positions[vid];
	float3 normal = float3(0.0, 1.0, 0.0);
	if ((push.flags & FLAG_HAS_NORMALS) != 0) normal = push.normals[vid];

	// Morph before skinning: blend shapes are authored against the rest mesh.
	if (push.morph_targets != 0 && morph != 0)
	{
		uint morph_base = morph - 1;
		for (uint t = 0; t < push.morph_targets; t++)
		{
			float amount = push.morph_weights[morph_base + t];
			if (amount == 0.0) continue;
			uint at = t * push.vertex_count + vid;
			position += amount * push.morph[at].position;
			normal += amount * push.morph[at].normal;
		}
	}

	uint4 joints = push.joints[vid];
	float4 weights = push.weights[vid];

	float pose_t = push.instances[iid].pose_t;
	BlendedPose pose;
	if (pose_t > 0.0)
	{
		pose = blend_frames(palette, base, push.instances[iid].pose_next & POSE_MASK, pose_t, joints, weights);
	}
	else
	{
		pose = blend_joints(palette, base, joints, weights);
	}

	apply_pose(pose, position, normal);
	push.output[index].position = position;
	push.output[index].normal = normal;
}

fn void computeMain(ComputeIn input) @compute @threads(64, 1, 1)
{
	skin_vertices(input);
}
