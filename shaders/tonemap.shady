// The tone curves, shared by the post chain's tonemap and by a scene that
// writes a headset's eye images itself (`scene_tone.shady`). Each takes linear
// light with the exposure already applied and returns linear light in 0..1: the
// `_SRGB` attachment does the display encode after it.
//
// A matrix literal fills columns here, so the matrices are three.js's as rows
// and every product is `mul(c, M)`. Matrix constants live inside the functions:
// a module-level constant is a scalar.

const float TONE_AGX_PIVOT_X = 0.6186810;
const float TONE_AGX_PIVOT_Y = 0.4886874;
const float TONE_AGX_SLOPE = 2.4290370;
const float TONE_AGX_TOE_POWER = 1.7141845;
const float TONE_AGX_SHOULDER_POWER = 1.4540615;
const float TONE_AGX_TOE_SCALE = 0.5357367;
const float TONE_AGX_SHOULDER_SCALE = 0.7450037;

// The seven-term fit of AgX's tone curve, over the 0..1 the log2 window
// produced, as three.js writes it.
fn float3 tone_agx_fit(float3 x)
{
	float3 x2 = x * x;
	float3 x4 = x2 * x2;
	return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}

// One hyperbolic segment of Blender's curve. The negative half is kept rather
// than clamped: at any x one of the two calls below has a negative argument, and
// the max inside the power keeps that branch finite so the select can throw it
// away. Clamping the argument would fold the wrong branch onto the pivot.
fn float3 tone_agx_segment(float3 u, float power)
{
	return u * pow(1.0 + pow(max(u, 0.0), power), -1.0 / power);
}

// Blender's own sigmoid, two segments meeting at the pivot, in place of the fit.
fn float3 tone_agx_blender_curve(float3 x)
{
	float3 toe = TONE_AGX_PIVOT_Y - TONE_AGX_TOE_SCALE
		* tone_agx_segment((TONE_AGX_PIVOT_X - x) * (TONE_AGX_SLOPE / TONE_AGX_TOE_SCALE), TONE_AGX_TOE_POWER);
	float3 shoulder = TONE_AGX_PIVOT_Y + TONE_AGX_SHOULDER_SCALE
		* tone_agx_segment((x - TONE_AGX_PIVOT_X) * (TONE_AGX_SLOPE / TONE_AGX_SHOULDER_SCALE), TONE_AGX_SHOULDER_POWER);
	return lerp(shoulder, toe, step(x, float3(TONE_AGX_PIVOT_X)));
}

// Into AgX's log window: Rec.2020, the inset, and the 16.5 stops from -12.47 EV
// to +4.03 EV as 0..1. The floor keeps log2(0) out of it.
fn float3 tone_agx_window(float3 c)
{
	float3x3 srgb_to_rec2020 = float3x3(
		float3(0.6274, 0.3293, 0.0433),
		float3(0.0691, 0.9195, 0.0113),
		float3(0.0164, 0.0880, 0.8956));
	float3x3 inset = float3x3(
		float3(0.856627153315983, 0.0951212405381588, 0.0482516061458583),
		float3(0.137318972929847, 0.761241990602591, 0.101439036467562),
		float3(0.11189821299995, 0.0767994186031903, 0.811302368396859));
	c = mul(c, srgb_to_rec2020);
	c = mul(c, inset);
	return clamp((log2(max(c, 1e-10)) + 12.47393) / (4.026069 + 12.47393), 0.0, 1.0);
}

// Back out of the window: the outset, the 2.2 the curve was made against, and
// sRGB primaries. The clamp is what a UNORM does to the out-of-gamut values the
// rotation back can produce.
fn float3 tone_agx_unwindow(float3 c)
{
	float3x3 rec2020_to_srgb = float3x3(
		float3(1.6605, -0.5876, -0.0728),
		float3(-0.1246, 1.1329, -0.0083),
		float3(-0.0182, -0.1006, 1.1187));
	float3x3 outset = float3x3(
		float3(1.1271005818144368, -0.11060664309660323, -0.016493938717834573),
		float3(-0.1413297634984383, 1.157823702216272, -0.016493938717834257),
		float3(-0.14132976349843826, -0.11060664309660294, 1.2519364065950405));
	c = mul(c, outset);
	c = pow(max(c, 0.0), 2.2);
	c = mul(c, rec2020_to_srgb);
	return clamp(c, 0.0, 1.0);
}

// AgX through three.js's polynomial fit.
fn float3 tone_agx(float3 c)
{
	return tone_agx_unwindow(tone_agx_fit(tone_agx_window(c)));
}

// AgX through Blender's own curve.
fn float3 tone_agx_blender(float3 c)
{
	return tone_agx_unwindow(tone_agx_blender_curve(tone_agx_window(c)));
}
