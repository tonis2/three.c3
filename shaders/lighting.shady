// Direct lighting, ported to shady from `lighting.slang`'s shared block.
//
// A surface is lit by the punctual lights the cluster pass left it - the
// directionals from the frame's own list and the points, spots and area
// emitters from this fragment's cluster, each with its own shadow. What is
// **not** here yet, and is its own piece of work rather than an omission to be
// discovered later:
//
//  - **the bake pass's own diffuse** (`shared_baked_diffuse`), which the
//    lightmap pass still compiles from Slang; reading a tile and the
//    dynamic-caster delta that corrects it live here.
//
// The shape that matters is kept: the light list is the *cluster's*, so a
// fragment is lit by what the culling pass decided reaches it, and the two
// lists (frame directionals, clustered punctuals) are walked in the original's
// order.

// `Light.meta.z`: what kind of emitter this is. 0 is directional and carries no
// position at all; 4 is a spot, whose cone `spot_reach` narrows.
const uint LIGHT_DIRECTIONAL = 0u;
const uint LIGHT_POINT       = 1u;
const uint LIGHT_RECT        = 2u;
const uint LIGHT_DISK        = 3u;
const uint LIGHT_SPOT        = 4u;

// `Light.meta.w` bit 18: a receiver with a lightmap already has this light's
// direct diffuse in its tile. `shade_lights` skips the diffuse half for those
// and keeps the specular live; a receiver with no tile shades it in real time
// as though it were never baked.
const uint LIGHT_BAKED = 0x40000u;

// Whether this light's direct diffuse may be in a receiver's lightmap. A
// receiver without a tile shades it in real time as though it were never baked.
fn bool light_is_baked(Light light)
{
	return (light.meta.w & LIGHT_BAKED) != 0u;
}

// The shadow atlas through a depth-compare sampler, and the same image through
// the *static* compare sampler a baked receiver reads so that the tile's own
// shadows are the ones it was baked with. The engine binds both every draw, in
// the frame's set - see `render/pass.c3` - and both carry the 1x1 white when no
// shadow pass ran, which the comparison reads as "fully lit" by construction.
//
// **The binding numbers are the engine's, not ones this file invented.** A port
// that renumbered them would leave the pass writing textures the module never
// reads, and nothing in either suite would say so.
Sampler2DShadow shadow_atlas_compare        @set(0) @binding(18);
Sampler2DShadow shadow_atlas_static_compare @set(0) @binding(21);

// The area-light fit, at the binding the Slang templates reserve for it. Rows
// 0-63 hold the fitted inverse and rows 64-127 the directional albedo, and
// `frame.lighting.w` says whether the image is on the device - zero falls back
// to the numeric quadrature below.
Sampler2D ltc_lut @set(0) @binding(19);

// A point or spot's cone, in cosine space: 1 inside, 0 outside, smooth between.
fn float spot_reach(Light light, float3 toward)
{
	return smoothstep(light.area_right.w, light.area_up.w, dot(normalize(light.area_right.xyz), -toward));
}

// Which way a light is from a surface, and how much of it arrives.
//
// A negative w means the "direction" really is a direction and every ray
// parallel: `reach` is one and the vector is normalized, which is the whole of a
// directional light. Above zero it is a *place*, and the return is the offset to
// it: `reach` carries the inverse square and the soft edge at the light's own
// range, so a lamp lights the room it is in and nothing past its radius rather
// than falling off like a star.
fn float3 light_toward(float4 packed, float3 position, out float reach)
{
	if (packed.w <= 0.0)
	{
		reach = 1.0;
		return normalize(packed.xyz);
	}

	float3 offset = packed.xyz - position;
	float square = max(dot(offset, offset), 1e-4);
	float distance = sqrt(square);

	float edge = saturate(1.0 - pow(distance / packed.w, 4.0));
	reach = edge * edge / square;
	return offset / distance;
}

// --- Shadows -----------------------------------------------------------------
//
// The sun's shadow, ported from `lighting.slang`'s shared block. One lookup and
// the comparison sampler that makes it four texels of hardware filtering.
//
// A view knows what it drew: `params.x` is one texel in its uv, `params.y` the
// script's depth bias, `params.z` the normal offset in world units, and
// `params.w` how much of the shadow to apply - zero in a frame with no shadow
// pass, which is the branch that answers "lit" without a tap.
//
// **The receiver-plane gradient is why this reads `plane_*` rather than taking
// derivatives.** A tap's expected depth is the depth of the plane the fragment
// lies on at that tap's ndc position, and the plane's slope in ndc falls out of
// the view's frame constants instead of out of a derivative taken inside a
// light-dependent branch.

// `cached` picks the static atlas, which a baked receiver compares against so
// that a moving caster's shadow shows up as the delta between the two maps.
// Spelled as a branch rather than a ternary: a sampled image is opaque, and the
// two samplers are two values SPIR-V cannot `select` between.
fn float shadow_compare(bool cached, float2 uv, float reference)
{
	if (cached) return shadow_atlas_static_compare.SampleCmpLevelZero(uv, reference);
	return shadow_atlas_compare.SampleCmpLevelZero(uv, reference);
}

// How much of one light's shadow reaches this point: 1 fully lit, 0 fully
// shadowed. Four texel centres, each compared at the receiver plane's own depth
// there and blended by where the fragment sits between them.
fn float shadow_view_factor_filtered_from(uint index, float3 position, float3 normal, bool cached)
{
	if (index == 0xffffffffu) return 1.0;
	ShadowGpuView view = push.frame[0].shadow_views[index];
	if (view.params.w <= 0.0) return 1.0;

	// The projection's four columns, read rather than multiplied: a column is
	// what `view_projection[i]` means here, and Slang's `vp[i][j]` was a *row*
	// - the two spellings index opposite things, which a verbatim port would
	// transpose in silence.
	float4x4 vp = view.view_projection;
	float4 cx = vp[0];
	float4 cy = vp[1];
	float4 cz = vp[2];
	float4 clip = cx * position.x + cy * position.y + cz * position.z + vp[3];
	if (clip.w <= 0.0) return 1.0;

	if (view.params.z != 0.0)
	{
		float distance = view.params.z;
		if (distance < 0.0)
		{
			// Convert receiver texels to world units at this exact perspective
			// depth. This keeps the offset useful far from a local light without
			// making it enormous close to the light.
			float2 ndc = clip.xy / clip.w;
			float inv_w = 1.0 / clip.w;
			float2 sx = (cx.xy - ndc * cx.w) * inv_w;
			float2 sy = (cy.xy - ndc * cy.w) * inv_w;
			float2 sz = (cz.xy - ndc * cz.w) * inv_w;
			float ndc_per_world = sqrt(max(max(dot(sx, sx), dot(sy, sy)), dot(sz, sz)));
			distance = (-view.params.z) * (2.0 * view.params.x) / max(ndc_per_world, 1e-6);
		}
		clip += distance * (cx * normal.x + cy * normal.y + cz * normal.z);
		if (clip.w <= 0.0) return 1.0;
	}

	float3 ndc = clip.xyz / clip.w;
	float2 local = float2(0.5 + 0.5 * ndc.x, 0.5 - 0.5 * ndc.y);
	if (ndc.z < 0.0 || ndc.z > 1.0 || any(local < 0.0) || any(local > 1.0)) return 1.0;

	float2 texel = view.params.x * view.atlas.xy;
	// Half a texel in from the tile, so a tap never reaches a neighbouring
	// view's depth.
	float2 lo = view.atlas.zw + texel * 0.5;
	float2 hi = view.atlas.zw + view.atlas.xy - texel * 0.5;

	// The receiver plane's depth slope in ndc: the cofactor rows in
	// `plane_*.xyz` and the inverse-transposed w row in their w, which is the
	// rank-one update of the projection's 3x3.
	float inv_w = 1.0 / clip.w;
	float4 plane_x = push.frame[0].shadow_views[index].plane_x;
	float4 plane_y = push.frame[0].shadow_views[index].plane_y;
	float4 plane_z = push.frame[0].shadow_views[index].plane_z;
	float3 plane_w = float3(plane_x.w, plane_y.w, plane_z.w);
	float3 plane_n = float3(dot(plane_x.xyz, normal), dot(plane_y.xyz, normal), dot(plane_z.xyz, normal));
	float3 plane_ndc = plane_n * (1.0 - dot(ndc, plane_w)) + plane_w * dot(ndc, plane_n);
	float2 gradient = abs(plane_ndc.z) * (inv_w * inv_w) > 1e-8
		? -plane_ndc.xy / plane_ndc.z
		: float2(0.0);

	// Four taps, each landed on a texel centre so the hardware weighs one texel
	// and the plane depth above is that texel's own depth.
	const float2 adjacent[4] = {
		float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0), float2(1.0, 1.0)
	};
	float2 texel_position = local / view.params.x - 0.5;
	float2 fraction = frac(texel_position);
	float2 base = floor(texel_position);
	float samples[4];
	[unroll] for (int i = 0; i < 4; i++)
	{
		float2 tap_local = clamp(
			(base + adjacent[i] + 0.5) * view.params.x,
			view.params.x * 0.5,
			1.0 - view.params.x * 0.5
		);
		float2 tap_ndc = (tap_local - local) * float2(2.0, -2.0);
		float reference = ndc.z + dot(gradient, tap_ndc) - view.params.y;
		samples[i] = shadow_compare(cached, clamp(tap_local * view.atlas.xy + view.atlas.zw, lo, hi), reference);
	}
	float lit = lerp(
		lerp(samples[0], samples[1], fraction.x),
		lerp(samples[2], samples[3], fraction.x),
		fraction.y
	);
	return lerp(1.0, lit, view.params.w);
}

fn float shadow_view_factor_filtered(uint index, float3 position, float3 normal)
{
	return shadow_view_factor_filtered_from(index, position, normal, false);
}

// One light's shadow, from the view it names. `Light.meta.y` is that view's
// index, or 0xffffffff for a light with no view at all.
fn float shadow_factor(float3 position, float3 normal)
{
	return shadow_view_factor_filtered(push.frame[0].lights[0].meta.y, position, normal);
}

// The same for a point, spot or area emitter: one view per light, and a point
// light's six cube faces are six consecutive views, picked by which axis the
// ray to the light leaves through. An area emitter has one view at its centre -
// widening that silhouette invents a blocky penumbra rather than integrating
// the area.
fn float point_shadow_factor_from(uint index, Light light, float3 position, float3 normal, bool cached)
{
	uint view = light.meta.y;
	if (view == 0xffffffffu) return 1.0;
	if (light.meta.z == LIGHT_POINT)
	{
		float3 ray = position - light.direction.xyz;
		float3 a = abs(ray);
		uint face;
		if (a.x >= a.y && a.x >= a.z) face = ray.x >= 0.0 ? 0u : 1u;
		else if (a.y >= a.z) face = ray.y >= 0.0 ? 2u : 3u;
		else face = ray.z >= 0.0 ? 4u : 5u;
		view += face;
	}
	return shadow_view_factor_filtered_from(view, position, normal, cached);
}

fn float point_shadow_factor(uint index, Light light, float3 position, float3 normal)
{
	return point_shadow_factor_from(index, light, position, normal, false);
}

// --- Area lights --------------------------------------------------------------
//
// Kinds 2 and 3 are finite emitters: a rectangle and a disk. `area_right` and
// `area_up` are the emitter's axes with the half extents in their `w`, and
// `direction.xyz` is the emitter's *centre* rather than a direction.
//
// A polygon lit by a cosine distribution has a closed-form integral; a polygon
// lit by GGX does not. The Heitz fit says the lobe at one roughness and one
// view angle is that cosine seen through a linear map, so the integral becomes:
// transform the emitter's corners by the fitted inverse, take the cosine
// integral of the shape that comes out, scale by the directional albedo. Two
// texture reads replace the sixteen-sample loop below. `frame.lighting.w` says
// whether the fit is on the device; zero means the numeric reference, which is
// the honest fallback rather than a degraded one.

// The range window, and zero wherever the integral cannot be anything else: the
// point is behind the emitter plane, or the whole emitter is behind the surface.
// Every sample shares the sign of `dot(emitter,-l)`, and the extent bound is the
// furthest a sample can reach along the surface normal.
fn float area_window(Light light, float3 position, float3 normal, float3 right, float3 up, float3 emitter)
{
	float3 toward = light.direction.xyz - position;
	if (dot(emitter, -toward) <= 0.0) return 0.0;
	if (dot(normal, toward) + abs(dot(normal, right)) * light.area_right.w
		+ abs(dot(normal, up)) * light.area_up.w <= 0.0) return 0.0;
	float cd = distance(light.direction.xyz, position) / max(light.direction.w, 1e-4);
	return saturate(1.0 - cd * cd * cd * cd);
}

struct AreaTerms
{
	float diffuse;
	float3 specular;
}

// The numeric integration both fallbacks use: four by four midpoint samples
// over the emitter's own parameter square, the disk keeping the ones inside it.
// The window is shared with the fitted path so the two agree at the edges.
fn float area_reference_diffuse(Light light, float3 position, float3 normal)
{
	float3 right = normalize(light.area_right.xyz);
	float3 up = normalize(light.area_up.xyz);
	float3 emitter = -normalize(cross(right, up));
	float sum = 0.0;
	uint samples = 0u;
	float window = area_window(light, position, normal, right, up, emitter);
	if (window <= 0.0) return 0.0;
	for (uint y = 0u; y < 4u; y++)
	{
		for (uint x = 0u; x < 4u; x++)
		{
			float2 q = (float2(float(x), float(y)) + 0.5) * 0.5 - 1.0;
			if (light.meta.z == LIGHT_DISK && dot(q, q) > 1.0) continue;
			float3 p = light.direction.xyz + right * q.x * light.area_right.w + up * q.y * light.area_up.w;
			float3 ray = p - position;
			float d2 = max(dot(ray, ray), 1e-6);
			float3 toward = ray * rsqrt(d2);
			sum += max(dot(normal, toward), 0.0) * max(dot(emitter, -toward), 0.0) / d2;
			samples++;
		}
	}
	return light.color.w * sum * window * window / (3.14159265 * 3.14159265 * max(float(samples), 1.0));
}

fn AreaTerms area_reference_terms(Light light, float3 position, float3 normal, float3 view, float3 f0, float f90, float a2, float k, float nv)
{
	float3 right = normalize(light.area_right.xyz);
	float3 up = normalize(light.area_up.xyz);
	float3 emitter = -normalize(cross(right, up));
	float diffuse = 0.0;
	float3 specular = float3(0.0);
	uint samples = 0u;
	AreaTerms terms;
	terms.diffuse = 0.0;
	terms.specular = float3(0.0);
	float window = area_window(light, position, normal, right, up, emitter);
	if (window <= 0.0) return terms;
	for (uint y = 0u; y < 4u; y++)
	{
		for (uint x = 0u; x < 4u; x++)
		{
			float2 q = (float2(float(x), float(y)) + 0.5) * 0.5 - 1.0;
			if (light.meta.z == LIGHT_DISK && dot(q, q) > 1.0) continue;
			float3 ray = light.direction.xyz + right * q.x * light.area_right.w + up * q.y * light.area_up.w - position;
			float d2 = max(dot(ray, ray), 1e-6);
			float3 l = ray * rsqrt(d2);
			float nl = max(dot(normal, l), 0.0);
			float el = max(dot(emitter, -l), 0.0);
			diffuse += nl * el / d2;
			samples++;
			if (nl <= 0.0 || el <= 0.0) continue;
			float3 h = normalize(l + view);
			float nh = max(dot(normal, h), 0.0);
			float vh = max(dot(view, h), 0.0);
			float den = nh * nh * (a2 - 1.0) + 1.0;
			float d = a2 / (3.14159265 * den * den);
			float g = (nl / (nl * (1.0 - k) + k)) * (nv / (nv * (1.0 - k) + k));
			float3 fresnel = f0 + (float3(f90) - f0) * pow(1.0 - vh, 5.0);
			specular += el / d2 * d * g * fresnel / (4.0 * nv);
		}
	}
	float scale = light.color.w * window * window / max(float(samples), 1.0);
	terms.diffuse = diffuse * scale / (3.14159265 * 3.14159265);
	terms.specular = light.color.rgb * specular * scale / 3.14159265;
	return terms;
}

fn float3 area_reference_specular(Light light, float3 position, float3 normal, float3 view, float3 f0, float f90, float a2, float k, float nv)
{
	float3 right = normalize(light.area_right.xyz);
	float3 up = normalize(light.area_up.xyz);
	float3 emitter = -normalize(cross(right, up));
	float3 sum = float3(0.0);
	uint samples = 0u;
	float window = area_window(light, position, normal, right, up, emitter);
	if (window <= 0.0) return float3(0.0);
	for (uint y = 0u; y < 4u; y++)
	{
		for (uint x = 0u; x < 4u; x++)
		{
			float2 q = (float2(float(x), float(y)) + 0.5) * 0.5 - 1.0;
			if (light.meta.z == LIGHT_DISK && dot(q, q) > 1.0) continue;
			float3 ray = light.direction.xyz + right * q.x * light.area_right.w + up * q.y * light.area_up.w - position;
			float d2 = max(dot(ray, ray), 1e-6);
			float3 l = ray * rsqrt(d2);
			float nl = max(dot(normal, l), 0.0);
			float el = max(dot(emitter, -l), 0.0);
			samples++;
			if (nl <= 0.0 || el <= 0.0) continue;
			float3 h = normalize(l + view);
			float nh = max(dot(normal, h), 0.0);
			float vh = max(dot(view, h), 0.0);
			float den = nh * nh * (a2 - 1.0) + 1.0;
			float d = a2 / (3.14159265 * den * den);
			float g = (nl / (nl * (1.0 - k) + k)) * (nv / (nv * (1.0 - k) + k));
			float3 fresnel = f0 + (float3(f90) - f0) * pow(1.0 - vh, 5.0);
			sum += el / d2 * d * g * fresnel / (4.0 * nv);
		}
	}
	return light.color.rgb * light.color.w * sum * window * window / (3.14159265 * max(float(samples), 1.0));
}

// 63/64 and 0.5/64: the half-texel bias keeps a tap inside its own half of the
// image, so the inverse and the albedo never blend into each other. Spelled as
// numbers because a module-level constant takes a literal, not an expression.
const float LTC_LUT_SCALE = 0.984375;
const float LTC_LUT_BIAS = 0.0078125;

// The vector form factor of one edge: `cross(v1,v2)` scaled by the angle
// between them over its sine. Hill's rational approximation, exact enough that
// no version of this ever used `acos`.
fn float3 ltc_edge(float3 v1, float3 v2)
{
	float x = dot(v1, v2);
	float y = abs(x);
	float a = 0.8543985 + (0.4965155 + 0.0145206 * y) * y;
	float b = 3.4175940 + (4.1616724 + y) * y;
	float v = a / b;
	float theta_sin_theta = x > 0.0 ? v : 0.5 * rsqrt(max(1.0 - x * x, 1e-7)) - v;
	return cross(v1, v2) * theta_sin_theta;
}

// The emitter as a polygon of directions from the shading point, plus the
// shared scale both lobes end up multiplied by; `scale` is zero when the range
// window or either early-out has already answered. Six corners always: a
// rectangle repeats its last one, and a disk is a hexagon of the same area, so
// every loop below unrolls against constant indices. The array is a member
// rather than a parameter because shady refuses array parameters.
struct AreaShape
{
	float3 corner[6];
	float scale;
}

// The horizon-clipped cosine integral, as a fraction of a full hemisphere. The
// polygon is convex, so the tangent plane cuts it in at most two places: every
// edge contributes the part above the horizon, and the one chord from where the
// boundary leaves to where it comes back closes the shape. The two crossings
// are named rather than pushed into an array, so both loops still unroll
// against constant indices.
fn float ltc_clipped(AreaShape shape, float3 axis)
{
	float d[6];
	[unroll] for (uint i = 0u; i < 6u; i++) d[i] = dot(shape.corner[i], axis);
	float3 sum = float3(0.0);
	float3 leaving = float3(0.0);
	float3 entering = float3(0.0);
	bool cut = false;
	[unroll] for (uint i = 0u; i < 6u; i++)
	{
		uint j = i == 5u ? 0u : i + 1u;
		bool here = d[i] >= 0.0;
		bool there = d[j] >= 0.0;
		if (here && there)
		{
			sum += ltc_edge(shape.corner[i], shape.corner[j]);
			continue;
		}
		if (!here && !there) continue;
		float3 span = lerp(shape.corner[i], shape.corner[j], d[i] / (d[i] - d[j]));
		float len2 = dot(span, span);
		if (here)
		{
			float3 at = len2 > 1e-12 ? span * rsqrt(len2) : shape.corner[i];
			sum += ltc_edge(shape.corner[i], at);
			leaving = at;
			cut = true;
		}
		else
		{
			float3 at = len2 > 1e-12 ? span * rsqrt(len2) : shape.corner[j];
			sum += ltc_edge(at, shape.corner[j]);
			entering = at;
		}
	}
	if (cut) sum += ltc_edge(leaving, entering);
	return max(dot(sum, axis), 0.0);
}

fn AreaShape area_shape(Light light, float3 position, float3 normal)
{
	AreaShape shape;
	shape.scale = 0.0;
	float3 right = normalize(light.area_right.xyz);
	float3 up = normalize(light.area_up.xyz);
	float3 emitter = -normalize(cross(right, up));
	float window = area_window(light, position, normal, right, up, emitter);
	[unroll] for (uint i = 0u; i < 6u; i++) shape.corner[i] = float3(0.0, 0.0, 1.0);
	if (window <= 0.0) return shape;

	float3 centre = light.direction.xyz - position;
	float3 r = right * light.area_right.w;
	float3 u = up * light.area_up.w;
	float area;
	if (light.meta.z == LIGHT_DISK)
	{
		// 1.0996 is the circumradius that gives a hexagon the ellipse's own area.
		float grow = 1.0996;
		float3 cosines = float3(1.0, 0.5, -0.5);
		float3 sines = float3(0.0, 0.86602540, 0.86602540);
		shape.corner[0] = centre + (r * cosines.x + u * sines.x) * grow;
		shape.corner[1] = centre + (r * cosines.y + u * sines.y) * grow;
		shape.corner[2] = centre + (r * cosines.z + u * sines.z) * grow;
		shape.corner[3] = centre - (r * cosines.x + u * sines.x) * grow;
		shape.corner[4] = centre - (r * cosines.y + u * sines.y) * grow;
		shape.corner[5] = centre - (r * cosines.z + u * sines.z) * grow;
		area = 3.14159265 * light.area_right.w * light.area_up.w;
	}
	else
	{
		// Wound so the form factor comes out positive on the side the emitter
		// faces; the window above has already answered for the other side.
		shape.corner[0] = centre - r - u;
		shape.corner[1] = centre + r - u;
		shape.corner[2] = centre + r + u;
		shape.corner[3] = centre - r + u;
		shape.corner[4] = shape.corner[3];
		shape.corner[5] = shape.corner[3];
		area = 4.0 * light.area_right.w * light.area_up.w;
	}
	[unroll] for (uint i = 0u; i < 6u; i++) shape.corner[i] = normalize(shape.corner[i]);
	// Convert the polygon form factor back to the emitter's power-per-area
	// scale. The horizon term above is an approximation, so parity comes from
	// sharing this path rather than claiming identity with the numeric
	// reference.
	shape.scale = light.color.w * window * window / (3.14159265 * max(area, 1e-6));
	return shape;
}

// Diffuse is the polygon's cosine form factor. It is view independent and does
// not use the fit texture; only the specular lobe needs that approximation.
fn float area_polygon_diffuse(AreaShape shape, float3 normal)
{
	return shape.scale * ltc_clipped(shape, normal);
}

struct AreaLtcContext
{
	// The fit's own frame: x along the view's tangential part, z the normal.
	float3 row0;
	float3 row1;
	float3 row2;
	float3 fresnel;
}

fn AreaLtcContext area_ltc_context(float3 normal, float3 view, float3 f0, float f90, float alpha, float nv)
{
	AreaLtcContext context;
	float3 tangential = view - normal * dot(view, normal);
	float len2 = dot(tangential, tangential);
	float3 t1 = len2 > 1e-8
		? tangential * rsqrt(len2)
		: normalize(abs(normal.z) < 0.999 ? cross(normal, float3(0.0, 0.0, 1.0)) : float3(1.0, 0.0, 0.0));
	float3 t2 = cross(normal, t1);

	float2 uv = float2(sqrt(alpha), sqrt(saturate(1.0 - nv))) * LTC_LUT_SCALE + LTC_LUT_BIAS;
	float4 m = ltc_lut.SampleLevel(float2(uv.x, uv.y * 0.5), 0.0);
	float4 albedo = ltc_lut.SampleLevel(float2(uv.x, 0.5 + uv.y * 0.5), 0.0);

	// The three rows of the fitted inverse already multiplied by the frame, so
	// a corner is three dot products rather than a change of basis and a
	// matrix.
	context.row0 = m.x * t1 + m.y * normal;
	context.row1 = t2;
	context.row2 = m.z * t1 + m.w * normal;
	context.fresnel = f0 * albedo.x + (float3(f90) - f0) * albedo.y;
	return context;
}

fn float3 area_ltc_specular(AreaShape shape, AreaLtcContext context)
{
	AreaShape local;
	local.scale = 0.0;
	[unroll] for (uint i = 0u; i < 6u; i++)
	{
		float3 c = shape.corner[i];
		local.corner[i] = normalize(float3(dot(context.row0, c), dot(context.row1, c), dot(context.row2, c)));
	}
	float form = ltc_clipped(local, float3(0.0, 0.0, 1.0));
	return shape.scale * form * context.fresnel;
}

// Both lobes for one area light, for a caller that shades a light on its own.
// `standard` walks the cluster instead and caches the context across lights.
fn AreaTerms area_terms(Light light, float3 position, float3 normal, float3 view, float3 f0, float f90, float a2, float k, float nv)
{
	AreaTerms terms;
	terms.diffuse = 0.0;
	terms.specular = float3(0.0);
	AreaShape shape = area_shape(light, position, normal);
	if (shape.scale <= 0.0) return terms;
	if (push.frame[0].lighting.w <= 0.0)
	{
		terms = area_reference_terms(light, position, normal, view, f0, f90, a2, k, nv);
		terms.diffuse = area_polygon_diffuse(shape, normal);
		return terms;
	}
	AreaLtcContext context = area_ltc_context(normal, view, f0, f90, k * 2.0, nv);
	terms.diffuse = area_polygon_diffuse(shape, normal);
	terms.specular = light.color.rgb * area_ltc_specular(shape, context);
	return terms;
}

// The same pair with the polygon and the fit context already known: what a
// fragment with several area lights pays once for the shape and the two table
// reads, then reuses under each emitter.
fn AreaTerms area_terms_cached(Light light, AreaShape shape, float3 normal, AreaLtcContext context, bool diffuse)
{
	AreaTerms terms;
	terms.diffuse = 0.0;
	terms.specular = float3(0.0);
	if (diffuse) terms.diffuse = area_polygon_diffuse(shape, normal);
	terms.specular = light.color.rgb * area_ltc_specular(shape, context);
	return terms;
}

fn float area_diffuse(Light light, float3 position, float3 normal)
{
	AreaShape shape = area_shape(light, position, normal);
	if (shape.scale <= 0.0) return 0.0;
	return area_polygon_diffuse(shape, normal);
}

fn float3 area_specular(Light light, float3 position, float3 normal, float3 view, float3 f0, float f90, float a2, float k, float nv)
{
	if (push.frame[0].lighting.w <= 0.0)
		return area_reference_specular(light, position, normal, view, f0, f90, a2, k, nv);
	AreaShape shape = area_shape(light, position, normal);
	if (shape.scale <= 0.0) return float3(0.0);
	AreaLtcContext context = area_ltc_context(normal, view, f0, f90, k * 2.0, nv);
	return light.color.rgb * area_ltc_specular(shape, context);
}

// Only the visibility a *moving* caster took away from a baked light, read as
// the difference between the live atlas and the static one the bake recorded.
//
// The projected box is a cheap gate before the pair of lookups, and an area
// emitter's view is one depth view at its centre, so its removed diffuse is
// the polygon form factor under the same delta.
fn float3 baked_dynamic_delta(FrameBlock* frame, float3 normal, float3 receiver_normal, float3 position)
{
	float3 delta = float3(0.0);
	uint count = (uint)frame[0].lighting.y;
	for (uint i = 0u; i < count; i++)
	{
		Light light = frame[0].lights[i];
		if (!light_is_baked(light) || light.meta.y == 0xffffffffu) continue;

		// A point light's six cube faces are six views.
		uint parts = light.meta.z == LIGHT_POINT ? 6u : 1u;
		bool inside = false;
		for (uint part = 0u; part < parts && !inside; part++)
		{
			ShadowGpuView view = frame[0].shadow_views[light.meta.y + part];
			float4 rect = view.dynamic_rect;
			if (rect.z <= rect.x || rect.w <= rect.y) continue;
			float4 clip = view.view_projection * float4(position, 1.0);
			if (clip.w <= 0.0) continue;
			float2 ndc = clip.xy / clip.w;
			float2 uv = float2(0.5 + 0.5 * ndc.x, 0.5 - 0.5 * ndc.y);
			inside = all(uv >= rect.xy) && all(uv <= rect.zw);
		}
		if (!inside) continue;

		float live = point_shadow_factor_from(i, light, position, receiver_normal, false);
		float cached = point_shadow_factor_from(i, light, position, receiver_normal, true);
		float visibility = min(live - cached, 0.0);
		if (visibility >= 0.0) continue;

		if (light.meta.z == LIGHT_RECT || light.meta.z == LIGHT_DISK)
		{
			AreaShape shape = area_shape(light, position, normal);
			float area = shape.scale > 0.0 ? area_polygon_diffuse(shape, normal) : 0.0;
			delta += light.color.rgb * area * visibility;
			continue;
		}
		float reach;
		float3 toward = light_toward(light.direction, position, reach);
		if (light.meta.z == LIGHT_SPOT) reach *= spot_reach(light, toward);
		float nl = max(dot(normal, toward), 0.0);
		delta += light.color.rgb * light.color.w * reach * nl * visibility;
	}
	return delta;
}

// This fragment's place in the cluster grid, from its screen position and its
// distance to the camera - the same arithmetic the culling pass ran in reverse,
// and it has to stay that arithmetic to the last `min`.
fn uint fragment_cluster(FrameBlock* frame, float4 screen_position, float3 position)
{
	uint3 grid = frame[0].cluster_grid.xyz;
	float2 extent = max(frame[0].cluster_screen.xy, float2(1.0));

	uint x = min((uint)(screen_position.x * float(grid.x) / extent.x), grid.x - 1u);
	uint y = min((uint)(screen_position.y * float(grid.y) / extent.y), grid.y - 1u);

	float near_plane = frame[0].cluster_screen.z;
	float far_plane = frame[0].cluster_screen.w;
	float depth = max(distance(position, frame[0].camera.xyz), near_plane);
	uint z = min((uint)(saturate(log(depth / near_plane) / log(far_plane / near_plane)) * float(grid.z)),
		grid.z - 1u);

	return x + grid.x * (y + grid.y * z);
}

// GGX's distribution, Smith's height-correlated visibility with the k the
// original uses, and Schlick's Fresnel. One light's specular lobe, for a surface
// whose roughness has already been squared.
fn float3 punctual_specular(float3 normal, float3 view, float3 toward, float nl, float3 f0, float f90, float a2, float k, float nv)
{
	float3 h = normalize(toward + view);
	float nh = max(dot(normal, h), 0.0);
	float vh = max(dot(view, h), 0.0);

	float den = nh * nh * (a2 - 1.0) + 1.0;
	float d = a2 / (3.14159265 * den * den);
	float g = (nl / (nl * (1.0 - k) + k)) * (nv / (nv * (1.0 - k) + k));
	float3 fresnel = f0 + (float3(f90) - f0) * pow(1.0 - vh, 5.0);

	return d * g * fresnel / (4.0 * nv);
}

// One surface's direct light, in two terms: what it scatters and what it
// mirrors. Kept apart because a material gets to weight them differently - and
// because a scene with no specular costs nothing to leave at zero.
struct LightTerms
{
	float3 diffuse;
	float3 specular;
}

// Every light that reaches this fragment.
//
// The directional lights are the frame's own list: there are few, they are
// infinite, and a cluster cannot cull them. Everything with a position is found
// through the culling pass's cluster, whose counts and indices are the frame
// block's - and whose overflow bit means "the culling gave up on this cluster,
// shade it with every light there is", which is what makes the pair correct at
// any scale rather than only at the scale it was tuned for.
fn LightTerms shade_lights(
	FrameBlock* frame,
	float4 screen_position,
	float3 position,
	float3 normal,
	float3 receiver_normal,
	float3 albedo,
	float roughness,
	float metalness,
	float reflectance,
	float sun_shadow,
	bool skip_baked_diffuse)
{
	float3 view = normalize(frame[0].camera.xyz - position);
	float3 f0 = lerp(float3(0.16 * reflectance * reflectance), albedo, metalness);
	float f90 = clamp(dot(f0, float3(16.5)), 0.0, 1.0);
	float a = max(roughness * roughness, 1e-3);
	float a2 = a * a;
	float nv = max(dot(normal, view), 1e-4);
	float k = a * 0.5;

	LightTerms terms;
	terms.diffuse = float3(0.0);
	terms.specular = float3(0.0);

	uint count = (uint)frame[0].lighting.y;
	for (uint i = 0u; i < count; i++)
	{
		Light light = frame[0].lights[i];
		if (light.meta.z != LIGHT_DIRECTIONAL) continue;

		float reach;
		float3 toward = light_toward(light.direction, position, reach);
		float nl = max(dot(normal, toward), 0.0);
		if (nl * reach <= 0.0) continue;

		// Only light zero is the sun the shadow map was fitted around; a second
		// directional has a view of its own or none, which `point_shadow_factor`
		// answers.
		float visibility = i == 0u ? sun_shadow : point_shadow_factor(i, light, position, receiver_normal);
		float3 energy = light.color.rgb * light.color.w * reach * visibility;
		// A light map holds diffuse only, so a baked light's highlight stays in
		// this real-time loop; only the diffuse half is the tile's.
		if (!(skip_baked_diffuse && light_is_baked(light))) terms.diffuse += energy * nl;
		terms.specular += energy * punctual_specular(normal, view, toward, nl, f0, f90, a2, k, nv);
	}

	uint cluster = fragment_cluster(frame, screen_position, position);
	uint packed = frame[0].cluster_grid.w == 0u ? 0x80000000u : frame[0].cluster_counts[cluster];
	bool overflow = (packed & 0x80000000u) != 0u;
	uint local_count = overflow ? count : packed;

	// The fit context depends on the surface and the view, not on the emitter,
	// so every area light in this fragment's cluster shares one pair of table
	// reads. Built lazily: a frame with no area lights pays neither.
	bool area_context_ready = false;
	AreaLtcContext area_context;

	for (uint local = 0u; local < local_count; local++)
	{
		uint i = overflow ? local : frame[0].cluster_indices[cluster * frame[0].cluster_grid.w + local];
		Light light = frame[0].lights[i];
		bool skip_diffuse = skip_baked_diffuse && light_is_baked(light);

		if (light.meta.z == LIGHT_RECT || light.meta.z == LIGHT_DISK)
		{
			AreaTerms area;
			if (push.frame[0].lighting.w <= 0.0)
			{
				area = area_reference_terms(light, position, normal, view, f0, f90, a2, k, nv);
			}
			else
			{
				AreaShape shape = area_shape(light, position, normal);
				if (shape.scale <= 0.0) continue;
				if (!area_context_ready)
				{
					area_context = area_ltc_context(normal, view, f0, f90, k * 2.0, nv);
					area_context_ready = true;
				}
				area = area_terms_cached(light, shape, normal, area_context, !skip_diffuse);
			}
			if (area.diffuse <= 0.0 && dot(area.specular, float3(1.0)) <= 0.0) continue;
			// One visibility for both lobes, like the punctual branch below.
			float visibility = point_shadow_factor(i, light, position, receiver_normal);
			if (!skip_diffuse) terms.diffuse += light.color.rgb * area.diffuse * visibility;
			terms.specular += area.specular * visibility;
			continue;
		}

		if (light.meta.z != LIGHT_POINT && light.meta.z != LIGHT_SPOT) continue;

		float reach;
		float3 toward = light_toward(light.direction, position, reach);
		if (light.meta.z == LIGHT_SPOT) reach *= spot_reach(light, toward);

		float nl = max(dot(normal, toward), 0.0);
		if (nl * reach <= 0.0) continue;

		float visibility = point_shadow_factor(i, light, position, receiver_normal);
		float3 energy = light.color.rgb * light.color.w * reach * visibility;
		if (!skip_diffuse) terms.diffuse += energy * nl;
		terms.specular += energy * punctual_specular(normal, view, toward, nl, f0, f90, a2, k, nv);
	}

	return terms;
}
