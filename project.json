{
	"langrev": "1",
	"warnings": ["no-unused"],
	"authors": [],
	"version": "0.1.5",
	"dependency-search-paths": ["lib"],
	"dependencies": ["vk", "c3w", "gltf", "image", "collision", "fastjs", "mcp", "ktx", "font", "cui", "shady", "openxr"],
	"features": [],
	"macos-min-version": "26.0",
	"wincrt": "dynamic",
	"script-dir": "./",
	"test-sources": ["test/**"],
	"targets": {
		"three": {
			"type": "executable",
			"opt": "O1",
			"sources": ["src/**"]
		},
		// The Quest build: packaging/android/build-apk.sh links this archive into
		// the NativeActivity's libthree.so.
		"quest": {
			"type": "static-lib",
			"opt": "O2",
			"sources": ["src/**"],
			"target": "android-aarch64",
			"android-api": 32
		}
	},
	"output": "./build"
}
