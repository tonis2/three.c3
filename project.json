{
	"langrev": "1",
	"warnings": ["no-unused"],
	"authors": [],
	"version": "0.1.0",
	"dependency-search-paths": ["lib"],
	// quickjs and mcp arrived with M3, which is what `js/` and `mcp/` are.
	//
	// **quickjs has a submodule of its own** — `vendor/quickjs-ng`, which its
	// shim `#include`s. A checkout without `--recursive` leaves that directory
	// empty and the build fails in the C compiler rather than anywhere that
	// mentions submodules. `git submodule update --init --recursive` fixes it.
	"dependencies": ["vk", "c3w", "gltf", "image", "collision", "quickjs", "mcp"],
	"features": [],
	"script-dir": "./",
	// Compiled into `c3c test` alongside the default target's sources, so a
	// check here reaches anything in src/ without needing a target of its own.
	"test-sources": ["test/**"],
	"targets": {
		"three": {
			"type": "executable",
			"sources": ["src/**"]
		},
		// A convenience, never the only way the .spv gets there: shaders/mesh.spv
		// is read from disk at startup, so re-running slangc by hand changes the
		// picture without rebuilding the app.
		//
		// **Last on purpose.** `c3c build` with no target builds the first one
		// listed; a prepare target at the top turns every plain build into a
		// shader compile that reports success and produces no binary. Needs
		// --trust=full, or c3c skips the exec and still reports success.
		"shaders": {
			"type": "prepare",
			// -force-glsl-scalar-layout is not optional and is not decoration:
			// without it slangc emits a *different* module, and the tightly
			// packed float3/float2 streams the C3 side uploads are then read at
			// std430 strides. Building through this target and building by hand
			// have to produce the same bytes or the disagreement shows up as
			// geometry read a third of the way off.
			"exec": [
				"slangc ./shaders/mesh.slang -target spirv -emit-spirv-directly -fvk-use-entrypoint-name -force-glsl-scalar-layout -o ./shaders/mesh.spv"
			]
		}
	},
	"output": "./build"
}
